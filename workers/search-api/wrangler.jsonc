{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worldcons-search-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://worldcons-search-api.cclib.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
