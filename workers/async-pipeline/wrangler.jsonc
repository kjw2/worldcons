{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worldcons-ingest",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "limits": { "subrequests": 50000 },
  "browser": { "binding": "BROWSER" },
  "services": [
    { "binding": "WORLDCONS_APP_SERVICE", "service": "worldcons", "entrypoint": "WorldconsOpsService" }
  ],
  "r2_buckets": [
    { "binding": "WORLDCONS_RAW", "bucket_name": "worldcons-artifacts" }
  ],
  "d1_databases": [
    { "binding": "WORLDCONS_OPS", "database_name": "worldcons_ops", "database_id": "6ecdf64b-d95a-49b2-8fc4-bdd50581a3e4" },
    { "binding": "WORLDCONS_CORE", "database_name": "worldcons_core", "database_id": "0f4c41f0-778f-4ef4-860e-b0dad05f0984" },
    { "binding": "WORLDCONS_INGEST", "database_name": "worldcons_ingest", "database_id": "0ccd27ff-fd16-4071-bc94-616690708c4e" },
    { "binding": "WORLDCONS_SEARCH", "database_name": "worldcons_search", "database_id": "1d74ebba-918b-4f8c-9c5c-9013479df809" }
  ],
  "vars": {
    "M8_SCHEDULER_ENABLED": "true",
    "M8_ENABLED_KINDS": "admin-job-drain,watchdog,crawler-daily,search-projection-sync,admin-health,embedding-backfill,translation-drain,publication-drain,analytics-retention",
    "TRANSLATION_DRAIN_LIMIT": "10",
    "TRANSLATION_DRAIN_MAX_PASSES": "1",
    "PUBLICATION_DRAIN_LIMIT": "100",
    "CASE_CATALOG_GERMANY_HISTORY_ENABLED": "true",
    "BROWSER_ALLOWED_HOSTS": "bundesverfassungsgericht.de,supremecourt.gov,conseil-constitutionnel.fr,tribunalconstitucional.es",
    "SITE_ANALYTICS_RETENTION_DAYS": "90",
    "WORLDCONS_INGEST_STAGES_ENABLED": "false",
    "WORLDCONS_INGEST_STAGE_ENVIRONMENT": "production",
    "WORLDCONS_INGEST_STAGE_ALLOWLIST": "",
    "WORLDCONS_INGEST_STAGE_DISPATCH_LIMIT": "25",
    "WORLDCONS_INGEST_STAGE_LEASE_SECONDS": "300"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 21 * * *",
      "30 1 * * *",
      "30 3,9,15,21 * * *",
      "50 3,9,15,21 * * *",
      "17 20 * * *",
      "0 2 * * *"
    ]
  },
  "queues": {
    "producers": [
      { "binding": "ASYNC_QUEUE", "queue": "worldcons-async-v1" },
      { "binding": "STAGE_QUEUE_DISCOVERY", "queue": "worldcons-stage-discovery-v1" },
      { "binding": "STAGE_QUEUE_CRAWL", "queue": "worldcons-stage-crawl-v1" },
      { "binding": "STAGE_QUEUE_NORMALIZE", "queue": "worldcons-stage-normalize-v1" },
      { "binding": "STAGE_QUEUE_TRANSLATE", "queue": "worldcons-stage-translate-v1" },
      { "binding": "STAGE_QUEUE_PUBLIC_JUDGMENT", "queue": "worldcons-stage-public-judgment-v1" },
      { "binding": "STAGE_QUEUE_PUBLISH", "queue": "worldcons-stage-publish-v1" },
      { "binding": "STAGE_QUEUE_SEARCH", "queue": "worldcons-stage-search-v1" }
    ],
    "consumers": [
      {
        "queue": "worldcons-async-v1",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-async-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-discovery-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-discovery-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-crawl-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-crawl-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-normalize-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-normalize-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-translate-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-translate-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-public-judgment-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-public-judgment-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-publish-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-publish-dlq-v1",
        "max_concurrency": 1
      },
      {
        "queue": "worldcons-stage-search-v1",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "worldcons-stage-search-dlq-v1",
        "max_concurrency": 1
      }
    ]
  },
  "workflows": [
    { "binding": "ASYNC_WORKFLOW", "name": "worldcons-async-v1", "class_name": "WorldconsAsyncWorkflow" },
    { "binding": "BACKFILL_DISCOVER_WORKFLOW", "name": "worldcons-backfill-discover-v1", "class_name": "WorldconsBackfillDiscoverWorkflow" },
    { "binding": "BACKFILL_WORKFLOW", "name": "worldcons-backfill-v1", "class_name": "WorldconsBackfillWorkflow" },
    { "binding": "BACKFILL_NORMALIZE_WORKFLOW", "name": "worldcons-backfill-normalize-v1", "class_name": "WorldconsBackfillNormalizeWorkflow" },
    { "binding": "BACKFILL_VERIFY_WORKFLOW", "name": "worldcons-backfill-verify-v1", "class_name": "WorldconsBackfillVerifyWorkflow" },
    { "binding": "BACKFILL_STAGE_WORKFLOW", "name": "worldcons-backfill-publish-v1", "class_name": "WorldconsBackfillPublishWorkflow" }
  ]
}
