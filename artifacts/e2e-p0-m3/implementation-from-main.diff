diff --git a/lib/cloudflare/e2e/contracts.ts b/lib/cloudflare/e2e/contracts.ts
new file mode 100644
index 0000000..c2491c7
--- /dev/null
+++ b/lib/cloudflare/e2e/contracts.ts
@@ -0,0 +1,78 @@
+import { canonicalJson } from "@/lib/backfill/canonical-json";
+
+export const APPROVAL_HASH_SCHEMA = "worldcons.approval.v1";
+export const GENERATION_HASH_SCHEMA = "worldcons.generation.v1";
+export const PROJECTION_INPUT_SCHEMA = "worldcons.projection-input.v1";
+// Bump when FTS encoding changes independently of search_documents.
+export const FTS_INPUT_VERSION = 1;
+
+/** Explicit opt-in. Evidence is supplied by the approval owner, not invented here. */
+export interface E2EApprovalContext {
+  policyVersion: string;
+  mode: "human" | "automatic";
+  evidenceRef: string;
+  sourceEvidenceRef: string;
+  pipelineRunId?: string | null;
+  discoveryCandidateId?: string | null;
+}
+
+export interface E2EGenerationReceipt {
+  generationId: string;
+  generationSeq: number;
+  approvalKey: string;
+  approvalSnapshotHash: string;
+  projectionInputHash: string;
+  created: boolean;
+  searchRepairOutboxId?: string;
+}
+
+export function validE2EApproval(value: unknown): value is E2EApprovalContext {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const input = value as Record<string, unknown>;
+  const bounded = (field: unknown, max: number) => typeof field === "string" && field.trim().length > 0 && field.length <= max;
+  return bounded(input.policyVersion, 160)
+    && (input.mode === "human" || input.mode === "automatic")
+    && bounded(input.evidenceRef, 500) && bounded(input.sourceEvidenceRef, 500)
+    && (input.pipelineRunId == null || bounded(input.pipelineRunId, 160))
+    && (input.discoveryCandidateId == null || bounded(input.discoveryCandidateId, 160));
+}
+
+export async function sha256Canonical(value: unknown): Promise<string> {
+  const digest = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(canonicalJson(value))));
+  return [...digest].map((byte) => byte.toString(16).padStart(2, "0")).join("");
+}
+
+function json(value: unknown): unknown {
+  if (typeof value !== "string") return value ?? null;
+  return JSON.parse(value);
+}
+
+/**
+ * Immutable P3/content fields only. Operational timestamps/storage locations,
+ * retry/error metadata and actor/model accounting do not approve new content.
+ * JSON key order is ignored; arrays, body whitespace and Unicode are preserved.
+ * Missing optional role/anchor fields have the same explicit NULL as DB NULL.
+ */
+export async function approvalIdentity(articleId: string, snapshot: Record<string, unknown>, policyVersion: string) {
+  const sourceContentHash = await sha256Canonical({ schema: "worldcons.source-text.v1", cleanedText: snapshot.cleaned_text ?? null });
+  const fields = ["slug", "source_key", "jurisdiction", "institution_name", "content_type",
+    "original_language", "original_title", "korean_title", "original_published_at",
+    "original_url", "canonical_url", "cleaned_text", "case_key", "version_role",
+    "source_anchor_version_id", "enrichment_source_content_hash", "source_content_hash",
+    "authority_evidence_hash", "source_snapshot_hash", "case_metadata_snapshot", "case_identifiers_snapshot"];
+  const body: Record<string, unknown> = { schema: APPROVAL_HASH_SCHEMA, articleId, sourceContentHash };
+  for (const field of fields) body[field] = snapshot[field] ?? null;
+  body.summary_json = json(snapshot.summary_json);
+  body.source_metadata = json(snapshot.source_metadata);
+  body.case_metadata_snapshot = json(snapshot.case_metadata_snapshot);
+  body.case_identifiers_snapshot = json(snapshot.case_identifiers_snapshot);
+  const approvalSnapshotHash = await sha256Canonical(body);
+  const approvalKey = await sha256Canonical({ schema: APPROVAL_HASH_SCHEMA, articleId, sourceContentHash, approvalSnapshotHash, policyVersion });
+  return { sourceContentHash, approvalSnapshotHash, approvalKey };
+}
+
+export function approvalContextDocument(input: E2EApprovalContext) {
+  return { policyVersion: input.policyVersion, mode: input.mode, evidenceRef: input.evidenceRef,
+    sourceEvidenceRef: input.sourceEvidenceRef, pipelineRunId: input.pipelineRunId ?? null,
+    discoveryCandidateId: input.discoveryCandidateId ?? null };
+}
diff --git a/lib/cloudflare/e2e/generation-ledger.ts b/lib/cloudflare/e2e/generation-ledger.ts
new file mode 100644
index 0000000..5b4e6a5
--- /dev/null
+++ b/lib/cloudflare/e2e/generation-ledger.ts
@@ -0,0 +1,147 @@
+import { searchRepairReservation } from "./search-repair-reservation";
+import { canonicalJson } from "@/lib/backfill/canonical-json";
+import type { ArticlePublicationTransitionInput } from "@/lib/article-publication/types";
+import type { D1RuntimeDatabase, D1RuntimePreparedStatement } from "@/lib/cloudflare/d1/runtime-binding";
+import { SEARCH_PROJECTION_VERSION } from "@/lib/cloudflare/search-projection/types";
+import { APPROVAL_HASH_SCHEMA, FTS_INPUT_VERSION, GENERATION_HASH_SCHEMA, PROJECTION_INPUT_SCHEMA,
+  approvalContextDocument, approvalIdentity, sha256Canonical, type E2EGenerationReceipt } from "./contracts";
+
+type Row = Record<string, unknown>;
+// D1 limits expression depth to 100. A flat AND chain over every article
+// column can exceed that even when it stays under the parameter limit.
+// Preserve every comparison and its binding order in a balanced tree.
+function allPredicates(predicates: string[]): string {
+  if (predicates.length === 1) return predicates[0];
+  const middle = Math.floor(predicates.length / 2);
+  return `(${allPredicates(predicates.slice(0,middle))} AND ${allPredicates(predicates.slice(middle))})`;
+}
+async function read(binding: D1RuntimeDatabase, sql: string, ...values: unknown[]): Promise<Row | null> {
+  const result = await binding.prepare(sql).bind(...values).all<Row>();
+  if (result.success === false || result.error) throw new Error("e2e.read_failed");
+  return result.results?.[0] ?? null;
+}
+
+// SQL serializes sorted tags; these exact bytes are asserted INSIDE the commit.
+// Tags can change without articles.updated_at changing.
+const TAG_SNAPSHOT_SQL = `SELECT json_group_array(json_object(
+  'tag_id',tag_id,'confidence',confidence,'slug',slug,'name',name,
+  'normalized_name',normalized_name,'type',type)) AS snapshot FROM (
+  SELECT at.tag_id,at.confidence,t.slug,t.name,t.normalized_name,t.type
+  FROM article_tags at LEFT JOIN tags t ON t.id=at.tag_id
+  WHERE at.article_id=? ORDER BY at.tag_id COLLATE BINARY)`;
+
+export async function readGenerationReplay(binding: D1RuntimeDatabase, input: ArticlePublicationTransitionInput) {
+  if (!input.e2eApproval) return undefined;
+  const row = await read(binding, `SELECT g.*,r.context_hash,r.generation_created,o.outbox_id
+    FROM e2e_generation_requests_v1 r JOIN e2e_generations_v1 g ON g.generation_id=r.generation_id
+    LEFT JOIN e2e_search_repair_outbox_v1 o ON o.article_id=g.article_id AND o.generation_id=g.generation_id
+    WHERE r.article_id=? AND r.idempotency_key=?`, input.articleId, input.idempotencyKey);
+  const contextHash = await sha256Canonical(approvalContextDocument(input.e2eApproval));
+  if (!row || row.context_hash !== contextHash || row.expected_publication_state !== input.targetState) {
+    throw new Error("e2e.invalid_replay");
+  }
+  return receipt(row, Number(row.generation_created) === 1);
+}
+
+function receipt(row: Row, created: boolean): E2EGenerationReceipt {
+  return { generationId: String(row.generation_id), generationSeq: Number(row.generation_seq),
+    approvalKey: String(row.approval_key), approvalSnapshotHash: String(row.approval_snapshot_hash),
+    projectionInputHash: String(row.projection_input_hash), created,
+    ...(row.outbox_id ? { searchRepairOutboxId: String(row.outbox_id) } : {}) };
+}
+
+export async function prepareGenerationCommit(binding: D1RuntimeDatabase, input: ArticlePublicationTransitionInput,
+  observed: { article: Row; p3Head: Row | null; v4Head: Row | null; publication: Row | null },
+  committed: { version: Row; publicationId: string; publicationRevision: number; now: string }) {
+  const approval = input.e2eApproval!;
+  const { article, p3Head, v4Head, publication } = observed;
+  const { version, publicationId, publicationRevision, now } = committed;
+  const previous = await read(binding, `SELECT g.* FROM e2e_generation_heads_v1 h
+    JOIN e2e_generations_v1 g ON g.generation_id=h.generation_id AND g.article_id=h.article_id
+    WHERE h.article_id=?`, input.articleId);
+  const tagSnapshot = String((await read(binding, TAG_SNAPSHOT_SQL, input.articleId))?.snapshot ?? "[]");
+  const identity = await approvalIdentity(input.articleId, version, approval.policyVersion);
+  const projectionInputHash = await sha256Canonical({ schema: PROJECTION_INPUT_SCHEMA,
+    articleId: input.articleId, versionId: version.id, versionRevision: Number(version.revision),
+    approvalSnapshotHash: identity.approvalSnapshotHash, publicationId, publicationRevision,
+    publicationState: input.targetState, tags: JSON.parse(tagSnapshot), reviewState: article.review_state ?? null,
+    projectionVersion: SEARCH_PROJECTION_VERSION, ftsInputVersion: FTS_INPUT_VERSION });
+  const created = !previous || previous.approval_key !== identity.approvalKey
+    || previous.projection_input_hash !== projectionInputHash;
+  const seq = previous ? Number(previous.generation_seq) + Number(created) : 1;
+  if (!Number.isSafeInteger(seq) || seq < 1) throw new Error("e2e.invalid_sequence");
+  const generationId = created ? await sha256Canonical({ schema: GENERATION_HASH_SCHEMA,
+    articleId: input.articleId, generationSeq: seq, approvalKey: identity.approvalKey,
+    expectedVersionId: version.id, targetState: input.targetState, projectionInputHash }) : String(previous!.generation_id);
+  const result: E2EGenerationReceipt = { generationId, generationSeq: seq,
+    approvalKey: identity.approvalKey, approvalSnapshotHash: identity.approvalSnapshotHash, projectionInputHash, created };
+  const token = crypto.randomUUID();
+  const predicates: string[] = [];
+  const values: unknown[] = [token];
+  // Names come from DB SELECT *, never request input. Even operational fields
+  // are compared: content hash equality does not waive snapshot freshness.
+  const columns = Object.keys(article);
+  if (columns.some((column) => !/^[a-z_][a-z0-9_]*$/.test(column))) throw new Error("e2e.invalid_column");
+  predicates.push(`EXISTS (SELECT 1 FROM articles WHERE ${allPredicates(columns.map((column) => '"'+column+'" IS ?'))})`);
+  values.push(...columns.map((column) => article[column] ?? null));
+  for (const [table, row, fields] of [
+    ["article_version_heads_p3",p3Head,["current_version_id","current_revision"]],
+    ["article_revision_heads_v4",v4Head,["current_version_id","current_revision"]],
+    ["article_publications_p3",publication,["id","state","version_id","revision"]],
+  ] as const) {
+    predicates.push(`COALESCE((SELECT json_array(${fields.join(',')}) FROM ${table} WHERE article_id=?),'null')=?`);
+    values.push(input.articleId, row ? JSON.stringify(fields.map((field) => row[field] ?? null)) : "null");
+  }
+  predicates.push("COALESCE((SELECT json_array(generation_id,generation_seq) FROM e2e_generation_heads_v1 WHERE article_id=?),'null')=?");
+  values.push(input.articleId, previous ? JSON.stringify([previous.generation_id,previous.generation_seq]) : "null");
+  predicates.push(`(${TAG_SNAPSHOT_SQL.replace(' AS snapshot','')})=?`);
+  values.push(input.articleId, tagSnapshot);
+  // Fail before writes if future schema exceeds D1's 100-parameter budget.
+  if (values.length > 100) throw new Error("e2e.guard_parameter_budget");
+  const guard = binding.prepare(`INSERT INTO e2e_commit_guards_v1 (token,assertion)
+    VALUES (?,CASE WHEN ${allPredicates(predicates)} THEN 1 ELSE 0 END)`).bind(...values);
+  const statements: D1RuntimePreparedStatement[] = [];
+  if (created) {
+    statements.push(binding.prepare(`INSERT INTO e2e_generations_v1
+      (generation_id,article_id,generation_seq,source_key,source_content_hash,approval_key,
+       approval_snapshot_hash,approval_hash_schema,projection_input_hash,projection_input_schema,
+       expected_version_id,expected_version_revision,expected_publication_id,expected_publication_revision,
+       expected_publication_state,approval_mode,policy_version,approval_evidence_ref,source_evidence_ref,
+       pipeline_run_id,discovery_candidate_id,created_at)
+      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).bind(
+      generationId,input.articleId,seq,version.source_key,identity.sourceContentHash,identity.approvalKey,
+      identity.approvalSnapshotHash,APPROVAL_HASH_SCHEMA,projectionInputHash,PROJECTION_INPUT_SCHEMA,
+      version.id,Number(version.revision),publicationId,publicationRevision,input.targetState,approval.mode,
+      approval.policyVersion,approval.evidenceRef,approval.sourceEvidenceRef,approval.pipelineRunId ?? null,
+      approval.discoveryCandidateId ?? null,now));
+    statements.push(binding.prepare(`INSERT INTO e2e_generation_heads_v1 (article_id,generation_id,generation_seq,updated_at)
+      VALUES (?,?,?,?) ON CONFLICT(article_id) DO UPDATE SET generation_id=excluded.generation_id,
+      generation_seq=excluded.generation_seq,updated_at=excluded.updated_at
+      WHERE e2e_generation_heads_v1.generation_id=? AND e2e_generation_heads_v1.generation_seq=?`).bind(
+      input.articleId,generationId,seq,now,previous?.generation_id ?? "",previous?.generation_seq ?? 0));
+    statements.push(binding.prepare(`INSERT INTO e2e_generation_progress_v1 (generation_id,state,updated_at)
+      VALUES (?,'publication_committed',?)`).bind(generationId,now));
+  }
+  statements.push(binding.prepare(`INSERT INTO e2e_generation_requests_v1
+    (article_id,idempotency_key,generation_id,context_hash,context_document,generation_created) VALUES (?,?,?,?,?,?)`).bind(
+    input.articleId,input.idempotencyKey,generationId,await sha256Canonical(approvalContextDocument(approval)),canonicalJson(approvalContextDocument(approval)),Number(created)));
+  const reservation = await searchRepairReservation(binding, { articleId: input.articleId,
+    generationId,generationSeq: seq,versionId: String(version.id),versionRevision: Number(version.revision),
+    publicationId,publicationRevision,publicationState: input.targetState,policyVersion: approval.policyVersion,
+    projectionInputHash,evidenceRef: created ? approval.evidenceRef : String(previous!.approval_evidence_ref) }, now);
+  statements.push(reservation.insert);
+  result.searchRepairOutboxId = reservation.outboxId;
+  if (created && previous) {
+    // Break both transport and Consumer ownership of old work in the SAME
+    // publication commit. Preserve verified rows/evidence as historical proof.
+    statements.push(binding.prepare(`UPDATE e2e_search_repair_outbox_v1 SET status='superseded',
+      fencing_token=fencing_token+1,dispatch_fence=dispatch_fence+1,
+      claimed_by=NULL,lease_expires_at=NULL,dispatch_owner=NULL,dispatch_token=NULL,
+      dispatch_lease_expires_at=NULL,last_error_code='e2e.generation_replaced',updated_at=?
+      WHERE article_id=? AND generation_id<>? AND status NOT IN ('verified','superseded')`).bind(now,input.articleId,generationId));
+    statements.push(binding.prepare(`UPDATE e2e_generation_progress_v1 SET state='superseded',updated_at=?
+      WHERE generation_id=? AND state<>'completed_verified'`).bind(now,previous.generation_id));
+  }
+  const cleanup = binding.prepare("DELETE FROM e2e_commit_guards_v1 WHERE token=?").bind(token);
+  return { result, guard, statements, cleanup };
+}
diff --git a/lib/cloudflare/e2e/generation-state.ts b/lib/cloudflare/e2e/generation-state.ts
new file mode 100644
index 0000000..78cc259
--- /dev/null
+++ b/lib/cloudflare/e2e/generation-state.ts
@@ -0,0 +1,43 @@
+import type { D1RuntimeDatabase } from "../d1/runtime-binding";
+import { SEARCH_PROJECTION_VERSION } from "../search-projection/types";
+import { FTS_INPUT_VERSION, PROJECTION_INPUT_SCHEMA, sha256Canonical } from "./contracts";
+import { CURRENT_GENERATION_SQL } from "./search-repair-dispatcher";
+
+export type GenerationRow = Record<string, unknown>;
+export async function e2eRows(db: D1RuntimeDatabase, sql: string, ...values: unknown[]) {
+  const result = await db.prepare(sql).bind(...values).all<GenerationRow>();
+  if (result.success === false || result.error || !Array.isArray(result.results)) throw new Error("e2e.read_unavailable");
+  return result.results;
+}
+export async function hasE2ETable(db: D1RuntimeDatabase, name: string) {
+  return (await e2eRows(db,"SELECT name FROM sqlite_master WHERE type='table' AND name=?",name))
+    .some((row) => row.name === name);
+}
+export function generationProjectionHash(g: GenerationRow, tags: unknown, reviewState: unknown) {
+  return sha256Canonical({ schema:PROJECTION_INPUT_SCHEMA,articleId:g.article_id,
+    versionId:g.expected_version_id,versionRevision:Number(g.expected_version_revision),
+    approvalSnapshotHash:g.approval_snapshot_hash,publicationId:g.expected_publication_id,
+    publicationRevision:Number(g.expected_publication_revision),publicationState:g.expected_publication_state,
+    tags,reviewState:reviewState ?? null,projectionVersion:SEARCH_PROJECTION_VERSION,ftsInputVersion:FTS_INPUT_VERSION });
+}
+export async function currentGenerations(db: D1RuntimeDatabase, ids: readonly string[]) {
+  const found = new Map<string,GenerationRow>();
+  if (!ids.length || !await hasE2ETable(db,"e2e_generation_heads_v1")) return found;
+  for (let offset=0;offset<ids.length;offset+=80) {
+    const part=ids.slice(offset,offset+80);
+    const rows=await e2eRows(db,`SELECT g.*,a.review_state,
+      CASE WHEN ${CURRENT_GENERATION_SQL} THEN 1 ELSE 0 END AS identity_current,
+      (SELECT json_group_array(json_object('tag_id',tag_id,'confidence',confidence,'slug',slug,'name',name,
+        'normalized_name',normalized_name,'type',type)) FROM (SELECT at.tag_id,at.confidence,t.slug,t.name,t.normalized_name,t.type
+        FROM article_tags at LEFT JOIN tags t ON t.id=at.tag_id WHERE at.article_id=g.article_id ORDER BY at.tag_id COLLATE BINARY)) AS tag_snapshot
+      FROM e2e_generation_heads_v1 h JOIN e2e_generations_v1 g ON g.generation_id=h.generation_id
+      LEFT JOIN articles a ON a.id=g.article_id WHERE h.article_id IN (${part.map(()=>"?").join(",")})`,...part);
+    for (const row of rows) {
+      row.input_current=Number(row.identity_current)===1
+        && !["needs_review","rejected","blocked"].includes(String(row.review_state))
+        && await generationProjectionHash(row,JSON.parse(String(row.tag_snapshot)),row.review_state)===row.projection_input_hash;
+      found.set(String(row.article_id),row);
+    }
+  }
+  return found;
+}
diff --git a/lib/cloudflare/e2e/public-freshness.ts b/lib/cloudflare/e2e/public-freshness.ts
new file mode 100644
index 0000000..cde80fe
--- /dev/null
+++ b/lib/cloudflare/e2e/public-freshness.ts
@@ -0,0 +1,81 @@
+import type { D1RuntimeDatabase } from "../d1/runtime-binding";
+import { ELIGIBLE_PUBLISHED_PREDICATE } from "../search-projection/d1-sync";
+import { currentGenerations, e2eRows, hasE2ETable, type GenerationRow } from "./generation-state";
+
+/** No per-result network calls and no cached eligibility. Failure is unavailable. */
+export async function assertPublicSearchFreshness(core:D1RuntimeDatabase,search:D1RuntimeDatabase,ids:readonly string[]) {
+  const unique=[...new Set(ids)];
+  const generations=await currentGenerations(core,unique);
+  const guards=new Map<string,GenerationRow>();
+  if (unique.length && await hasE2ETable(search,"e2e_search_generation_guards_v1")) {
+    for (let offset=0;offset<unique.length;offset+=80) {
+      const part=unique.slice(offset,offset+80);
+      for (const row of await e2eRows(search,`SELECT * FROM e2e_search_generation_guards_v1 WHERE article_id IN (${part.map(()=>"?").join(",")})`,...part)) guards.set(String(row.article_id),row);
+    }
+  }
+  for (const id of unique) {
+    const g=generations.get(id),guard=guards.get(id);
+    if (!g&&!guard) continue; // Legacy corpus remains outside the opt-in cohort.
+    if (!g||!guard||!g.input_current||g.expected_publication_state!=="published"||Number(guard.tombstone)!==0
+      || guard.generation_id!==g.generation_id||Number(guard.generation_seq)!==Number(g.generation_seq)
+      || guard.version_id!==g.expected_version_id||Number(guard.version_revision)!==Number(g.expected_version_revision)
+      || guard.publication_id!==g.expected_publication_id||Number(guard.publication_revision)!==Number(g.expected_publication_revision)
+      || guard.publication_state!==g.expected_publication_state||guard.policy_version!==g.policy_version
+      || guard.projection_input_hash!==g.projection_input_hash) throw new Error("e2e.public_projection_pending");
+  }
+  // Revalidate role eligibility and numeric attempt ownership in bounded queries.
+  const protectedIds=[...generations.keys()];
+  for (let offset=0;offset<protectedIds.length;offset+=80) {
+    const part=protectedIds.slice(offset,offset+80);
+    const eligible=await e2eRows(core,`SELECT p.article_id,o.fencing_token FROM article_publications_p3 p
+      JOIN article_content_versions_p3 v ON v.id=p.version_id AND v.article_id=p.article_id
+      JOIN e2e_generation_heads_v1 h ON h.article_id=p.article_id
+      JOIN e2e_search_repair_outbox_v1 o ON o.generation_id=h.generation_id
+      WHERE ${ELIGIBLE_PUBLISHED_PREDICATE} AND p.article_id IN (${part.map(()=>"?").join(",")})`,...part);
+    for (const id of part) {
+      const row=eligible.find(r=>r.article_id===id);
+      if (!row||Number(row.fencing_token)!==Number(guards.get(id)!.fencing_token)) throw new Error("e2e.public_projection_pending");
+    }
+  }
+  // Core B could commit while Search guards were being read. Check it again.
+  if (unique.length) {
+    const latest=await currentGenerations(core,unique);
+    for (const id of unique) {
+      const before=generations.get(id),after=latest.get(id);
+      if (before?.generation_id!==after?.generation_id || (after&&!after.input_current)) throw new Error("e2e.public_generation_changed");
+    }
+  }
+}
+
+/** Public Core content comes from the approved immutable P3, never mutable drafts. */
+export async function overlayPublicGenerationRows(core:D1RuntimeDatabase,rows:GenerationRow[]) {
+  const ids=rows.map(row=>String(row.id)), generations=await currentGenerations(core,ids);
+  if (!generations.size) return rows;
+  const versions=new Map<string,GenerationRow>();
+  const valid=[...generations.values()].filter(g=>g.input_current&&g.expected_publication_state==="published");
+  for (let offset=0;offset<valid.length;offset+=80) {
+    const part=valid.slice(offset,offset+80);
+    const found=await e2eRows(core,`SELECT v.* FROM article_content_versions_p3 v
+      JOIN article_publications_p3 p ON p.version_id=v.id AND p.article_id=v.article_id
+      WHERE ${ELIGIBLE_PUBLISHED_PREDICATE} AND v.id IN (${part.map(()=>"?").join(",")})`,...part.map(g=>g.expected_version_id));
+    for (const version of found) versions.set(String(version.id),version);
+  }
+  const result:GenerationRow[]=[];
+  const latest=await currentGenerations(core,ids);
+  for (const row of rows) {
+    const g=generations.get(String(row.id));
+    const current=latest.get(String(row.id));
+    if (g?.generation_id!==current?.generation_id || (current&&!current.input_current)) continue;
+    if (!g) { result.push(row); continue; }
+    const version=g.input_current&&g.expected_publication_state==="published" ? versions.get(String(g.expected_version_id)) : undefined;
+    if (!version) continue;
+    const approved={...row};
+    for (const column of Object.keys(row)) if (column in version && !["id","created_at","updated_at","article_tags"].includes(column)) {
+      const value=version[column];
+      approved[column]=["summary_json","source_metadata","case_metadata_snapshot","case_identifiers_snapshot"].includes(column)
+        && typeof value==="string" ? JSON.parse(value) : value;
+    }
+    result.push(approved);
+  }
+  return result;
+}
diff --git a/lib/cloudflare/e2e/search-generation-guard.ts b/lib/cloudflare/e2e/search-generation-guard.ts
new file mode 100644
index 0000000..8f2e1ea
--- /dev/null
+++ b/lib/cloudflare/e2e/search-generation-guard.ts
@@ -0,0 +1,76 @@
+import type { D1RuntimeDatabase } from "../d1/runtime-binding";
+import { SEARCH_DOCUMENT_COLUMNS, SEARCH_FTS_COLUMNS, type SearchProjectionDocument,
+  type SearchProjectionFtsDocument } from "../search-projection/types";
+import { sha256Canonical } from "./contracts";
+import { e2eRows, type GenerationRow } from "./generation-state";
+
+export interface SearchGenerationIdentity {
+  articleId:string; generationId:string; generationSeq:number; versionId:string; versionRevision:number;
+  publicationId:string; publicationRevision:number; publicationState:string; policyVersion:string;
+  projectionInputHash:string; fencingToken:number;
+}
+export function searchIdentity(g: GenerationRow, fence: number): SearchGenerationIdentity {
+  return { articleId:String(g.article_id),generationId:String(g.generation_id),generationSeq:Number(g.generation_seq),
+    versionId:String(g.expected_version_id),versionRevision:Number(g.expected_version_revision),
+    publicationId:String(g.expected_publication_id),publicationRevision:Number(g.expected_publication_revision),
+    publicationState:String(g.expected_publication_state),policyVersion:String(g.policy_version),
+    projectionInputHash:String(g.projection_input_hash),fencingToken:fence };
+}
+const identityColumns = ["generation_id","generation_seq","version_id","version_revision","publication_id",
+  "publication_revision","publication_state","policy_version","projection_input_hash"];
+function identityValues(i:SearchGenerationIdentity) { return [i.generationId,i.generationSeq,i.versionId,i.versionRevision,
+  i.publicationId,i.publicationRevision,i.publicationState,i.policyVersion,i.projectionInputHash]; }
+function body(row: Record<string,unknown>, columns: readonly string[]) {
+  return Object.fromEntries(columns.map((column)=>[column,row[column]??null]));
+}
+export async function projectionFingerprints(document:SearchProjectionDocument|null, fts:SearchProjectionFtsDocument|null) {
+  return { documentFingerprint:await sha256Canonical(document ? body(document as unknown as GenerationRow,SEARCH_DOCUMENT_COLUMNS) : null),
+    ftsFingerprint:await sha256Canonical(fts ? body(fts as unknown as GenerationRow,SEARCH_FTS_COLUMNS) : null) };
+}
+export async function projectionMatches(db:D1RuntimeDatabase,identity:SearchGenerationIdentity,
+  document:SearchProjectionDocument|null,fts:SearchProjectionFtsDocument|null) {
+  const [guards,docs,ftsRows] = await Promise.all([
+    e2eRows(db,"SELECT * FROM e2e_search_generation_guards_v1 WHERE article_id=?",identity.articleId),
+    e2eRows(db,"SELECT * FROM search_documents WHERE article_id=?",identity.articleId),
+    e2eRows(db,"SELECT * FROM search_fts WHERE article_id=?",identity.articleId),
+  ]);
+  const guard=guards[0], values=identityValues(identity), fingerprints=await projectionFingerprints(document,fts);
+  if (!guard || identityColumns.some((column,index)=>String(guard[column])!==String(values[index]))
+    || Number(guard.fencing_token)<identity.fencingToken || Number(guard.tombstone)!==Number(document===null)
+    || guard.document_fingerprint!==fingerprints.documentFingerprint || guard.fts_fingerprint!==fingerprints.ftsFingerprint) return false;
+  if (document===null) return docs.length===0 && ftsRows.length===0;
+  return docs.length===1 && ftsRows.length===1
+    && await sha256Canonical(body(docs[0],SEARCH_DOCUMENT_COLUMNS))===fingerprints.documentFingerprint
+    && await sha256Canonical(body(ftsRows[0],SEARCH_FTS_COLUMNS))===fingerprints.ftsFingerprint;
+}
+
+/** Search guard CAS, both materializations and authorization cleanup are ONE batch. */
+export async function applyGuardedSearchProjection(db:D1RuntimeDatabase,i:SearchGenerationIdentity,
+  document:SearchProjectionDocument|null,fts:SearchProjectionFtsDocument|null,now:string) {
+  if (!db.batch) throw new Error("e2e.search_batch_unavailable");
+  if (!Number.isSafeInteger(i.generationSeq)||i.generationSeq<1||!Number.isSafeInteger(i.fencingToken)||i.fencingToken<1
+    || (document===null)!==(fts===null) || (i.publicationState==="published")!==(document!==null)
+    || (document && (document.article_id!==i.articleId || fts?.article_id!==i.articleId))) throw new Error("e2e.invalid_search_identity");
+  const fingerprints=await projectionFingerprints(document,fts), token=crypto.randomUUID();
+  const sameIdentity=identityColumns.map((column)=>`${column}=?`).join(" AND ");
+  const statements=[db.prepare(`INSERT INTO e2e_search_commit_guards_v1 (token,assertion)
+    VALUES (?,CASE WHEN NOT EXISTS (SELECT 1 FROM e2e_search_generation_guards_v1 WHERE article_id=?)
+      OR EXISTS (SELECT 1 FROM e2e_search_generation_guards_v1 WHERE article_id=?
+        AND (generation_seq<? OR (${sameIdentity} AND fencing_token<=?))) THEN 1 ELSE 0 END)`).bind(
+      token,i.articleId,i.articleId,i.generationSeq,...identityValues(i),i.fencingToken),
+    db.prepare("INSERT INTO e2e_search_write_authorizations_v1 (article_id,token) VALUES (?,?)").bind(i.articleId,token),
+    db.prepare(`INSERT INTO e2e_search_generation_guards_v1 (article_id,${identityColumns.join(",")},fencing_token,
+      tombstone,document_fingerprint,fts_fingerprint,updated_at) VALUES (${Array(15).fill("?").join(",")})
+      ON CONFLICT(article_id) DO UPDATE SET ${[...identityColumns,"fencing_token","tombstone","document_fingerprint","fts_fingerprint","updated_at"].map(c=>`${c}=excluded.${c}`).join(",")}`).bind(
+        i.articleId,...identityValues(i),i.fencingToken,Number(document===null),fingerprints.documentFingerprint,fingerprints.ftsFingerprint,now),
+    db.prepare("DELETE FROM search_fts WHERE article_id=?").bind(i.articleId),
+    db.prepare("DELETE FROM search_documents WHERE article_id=?").bind(i.articleId)];
+  if (document && fts) statements.push(
+    db.prepare(`INSERT INTO search_documents (${SEARCH_DOCUMENT_COLUMNS.join(",")}) VALUES (${SEARCH_DOCUMENT_COLUMNS.map(()=>"?").join(",")})`).bind(...SEARCH_DOCUMENT_COLUMNS.map(c=>document[c])),
+    db.prepare(`INSERT INTO search_fts (${SEARCH_FTS_COLUMNS.join(",")}) VALUES (${SEARCH_FTS_COLUMNS.map(()=>"?").join(",")})`).bind(...SEARCH_FTS_COLUMNS.map(c=>fts[c])));
+  statements.push(db.prepare("DELETE FROM e2e_search_write_authorizations_v1 WHERE article_id=? AND token=?").bind(i.articleId,token),
+    db.prepare("DELETE FROM e2e_search_commit_guards_v1 WHERE token=?").bind(token));
+  const results=await db.batch(statements);
+  if (results.length!==statements.length || results.some(r=>r.success===false||r.error)) throw new Error("e2e.search_batch_failed");
+  return fingerprints;
+}
diff --git a/lib/cloudflare/e2e/search-repair-consumer.ts b/lib/cloudflare/e2e/search-repair-consumer.ts
new file mode 100644
index 0000000..51578d5
--- /dev/null
+++ b/lib/cloudflare/e2e/search-repair-consumer.ts
@@ -0,0 +1,132 @@
+import type { D1RuntimeDatabase } from "../d1/runtime-binding";
+import { buildSearchProjection } from "../search-projection/build";
+import { buildSearchProjectionInputFromEligibleRows, readEligibleSourceForArticle, readTagsForArticleIds } from "../search-projection/d1-sync";
+import { approvalIdentity } from "./contracts";
+import { currentGenerations, e2eRows, type GenerationRow } from "./generation-state";
+import { applyGuardedSearchProjection, projectionMatches, searchIdentity } from "./search-generation-guard";
+import { CURRENT_OUTBOX_SQL, isSearchRepairMessage } from "./search-repair-dispatcher";
+
+export interface SearchRepairConsumerOptions { clock?:()=>string; workerId?:string; random?:()=>number }
+const tagSql=`SELECT json_group_array(json_object('tag_id',tag_id,'confidence',confidence,'slug',slug,'name',name,
+  'normalized_name',normalized_name,'type',type)) FROM (SELECT at.tag_id,at.confidence,t.slug,t.name,t.normalized_name,t.type
+  FROM article_tags at LEFT JOIN tags t ON t.id=at.tag_id WHERE at.article_id=o.article_id ORDER BY at.tag_id COLLATE BINARY)`;
+function after(now:string,seconds:number) { return new Date(Date.parse(now)+seconds*1000).toISOString(); }
+async function batch(db:D1RuntimeDatabase,statements:ReturnType<D1RuntimeDatabase["prepare"]>[]) {
+  if (!db.batch) throw new Error("e2e.core_batch_unavailable");
+  const results=await db.batch(statements);
+  if (results.length!==statements.length||results.some(r=>r.success===false||r.error)) throw new Error("e2e.core_batch_failed");
+}
+async function desired(core:D1RuntimeDatabase,g:GenerationRow) {
+  if (!g.input_current) throw new Error("e2e.input_changed");
+  if (g.expected_publication_state!=="published") return { document:null,fts:null };
+  const versions=await e2eRows(core,"SELECT * FROM article_content_versions_p3 WHERE id=? AND article_id=?",g.expected_version_id,g.article_id);
+  if (!versions[0] || (await approvalIdentity(String(g.article_id),versions[0],String(g.policy_version))).approvalSnapshotHash!==g.approval_snapshot_hash) throw new Error("e2e.approval_snapshot_changed");
+  const source=await readEligibleSourceForArticle(core,String(g.article_id));
+  if (source.length!==1||source[0].version_id!==g.expected_version_id) throw new Error("e2e.publication_ineligible");
+  const tags=await readTagsForArticleIds(core,[String(g.article_id)]);
+  const built=buildSearchProjection(buildSearchProjectionInputFromEligibleRows(source,tags));
+  if (built.documents.length!==1) throw new Error("e2e.projection_ineligible");
+  // Re-read dynamic input after the independent projection reads.
+  const current=(await currentGenerations(core,[String(g.article_id)])).get(String(g.article_id));
+  if (!current?.input_current||current.generation_id!==g.generation_id||current.tag_snapshot!==g.tag_snapshot) throw new Error("e2e.input_changed");
+  return { document:built.documents[0],fts:built.ftsDocuments[0] };
+}
+
+/** M3 stops at durable Search application. M4 must verify the public API before completion. */
+export async function consumeSearchRepair(core:D1RuntimeDatabase,search:D1RuntimeDatabase,message:unknown,
+  options:SearchRepairConsumerOptions={}) {
+  if (!isSearchRepairMessage(message)) return { status:"invalid" } as const;
+  const clock=()=>new Date(options.clock?.()??Date.now()).toISOString();
+  const now=clock(), owner=options.workerId??`e2e-consumer:${crypto.randomUUID()}`;
+  if (!owner.trim()||owner.length>160) throw new Error("e2e.invalid_consumer_owner");
+  const row=(await e2eRows(core,"SELECT * FROM e2e_search_repair_outbox_v1 WHERE outbox_id=?",message.outboxId))[0];
+  if (!row) return { status:"missing" } as const;
+  if (["verified","superseded","dead_letter"].includes(String(row.status))) return { status:"terminal" } as const;
+  if (row.status==="leased"&&String(row.lease_expires_at)>now) return { status:"retry" } as const;
+  if (String(row.next_attempt_at)>now) return { status:"retry" } as const;
+  const g=(await currentGenerations(core,[String(row.article_id)])).get(String(row.article_id));
+  if (!g||g.generation_id!==row.generation_id) return { status:"superseded" } as const;
+  if (!g.input_current) return { status:"blocked" } as const;
+  let projection:Awaited<ReturnType<typeof desired>>|undefined;
+  try {
+    projection=await desired(core,g);
+    const receipts=await e2eRows(core,"SELECT * FROM e2e_search_apply_receipts_v1 WHERE generation_id=?",g.generation_id);
+    if (receipts[0]&&await projectionMatches(search,searchIdentity(g,Number(receipts[0].fencing_token)),projection.document,projection.fts)) {
+      const latest=(await currentGenerations(core,[String(row.article_id)])).get(String(row.article_id));
+      return { status:latest?.input_current&&latest.generation_id===g.generation_id?"awaiting_verification":"superseded" } as const;
+    }
+  } catch {
+    // Missing/corrupt Search state and projection failures go through the
+    // actual-owner processing budget. Queue duplicates do not own attempts.
+    projection=undefined;
+  }
+  // A crash on the final leased attempt must not leave an unclaimable row forever.
+  // Close exhausted work only after its owner expired, and fence that owner out.
+  const exhausted=`o.outbox_id=? AND (o.status IN ('pending','retry_wait') OR
+    (o.status='leased' AND o.lease_expires_at<=?)) AND ${CURRENT_OUTBOX_SQL}
+    AND (o.attempt_count>=o.max_attempts OR (o.first_failure_at IS NOT NULL AND o.first_failure_at<=?))`;
+  const exhaustedValues=[row.outbox_id,now,after(now,-7200)];
+  if (Number(row.attempt_count)>=Number(row.max_attempts)
+    || (row.first_failure_at&&Date.parse(now)-Date.parse(String(row.first_failure_at))>=7200000)) {
+    if (!core.batch) throw new Error("e2e.core_batch_unavailable");
+    const results=await core.batch([
+      core.prepare(`UPDATE e2e_generation_progress_v1 SET state='dead_letter',last_error_code='e2e.search_budget_exhausted',
+        updated_at=? WHERE generation_id=? AND state<>'completed_verified'
+        AND EXISTS (SELECT 1 FROM e2e_search_repair_outbox_v1 o WHERE ${exhausted})`).bind(now,g.generation_id,...exhaustedValues),
+      core.prepare(`UPDATE e2e_search_repair_outbox_v1 AS o SET status='dead_letter',claimed_by=NULL,lease_expires_at=NULL,
+        fencing_token=fencing_token+1,last_error_code='e2e.search_budget_exhausted',updated_at=?
+        WHERE ${exhausted} RETURNING outbox_id`).bind(now,...exhaustedValues)]);
+    if (results.length!==2||results.some(r=>r.success===false||r.error)) throw new Error("e2e.failure_record_unavailable");
+    return {status:results[1].results?.length===1?"dead_letter":"retry"} as const;
+  }
+  const claimed=(await e2eRows(core,`UPDATE e2e_search_repair_outbox_v1 AS o SET status='leased',claimed_by=?,
+    lease_expires_at=?,fencing_token=fencing_token+1,attempt_count=attempt_count+1,updated_at=?
+    WHERE outbox_id=? AND fencing_token=? AND attempt_count<max_attempts AND next_attempt_at<=?
+      AND (status IN ('pending','retry_wait') OR (status='leased' AND lease_expires_at<=?)) AND ${CURRENT_OUTBOX_SQL}
+    RETURNING *`,owner,after(now,300),now,row.outbox_id,row.fencing_token,now,now))[0];
+  if (!claimed) return { status:"retry" } as const;
+  const ownership=`o.outbox_id=? AND o.status='leased' AND o.claimed_by=? AND o.fencing_token=?
+    AND o.lease_expires_at>? AND ${CURRENT_OUTBOX_SQL}`;
+  const ownershipValues=(at:string)=>[row.outbox_id,owner,claimed.fencing_token,at];
+  try {
+    projection??=await desired(core,g);
+    const latest=(await currentGenerations(core,[String(row.article_id)])).get(String(row.article_id));
+    if (!latest?.input_current||latest.generation_id!==g.generation_id||latest.tag_snapshot!==g.tag_snapshot) throw new Error("e2e.input_changed");
+    const identity=searchIdentity(g,Number(claimed.fencing_token));
+    const fingerprints=await applyGuardedSearchProjection(search,identity,projection.document,projection.fts,clock());
+    if (!await projectionMatches(search,identity,projection.document,projection.fts)) throw new Error("e2e.search_readback_failed");
+    const settled=clock(), token=crypto.randomUUID();
+    // A zero-row lease/CAS outcome must abort receipt/progress/outbox together.
+    await batch(core,[core.prepare(`INSERT INTO e2e_commit_guards_v1 (token,assertion)
+      VALUES (?,CASE WHEN EXISTS (SELECT 1 FROM e2e_search_repair_outbox_v1 o WHERE ${ownership}
+        AND (SELECT review_state FROM articles WHERE id=o.article_id) IS ? AND (${tagSql})=?) THEN 1 ELSE 0 END)`).bind(
+        token,...ownershipValues(settled),g.review_state??null,g.tag_snapshot),
+      core.prepare(`INSERT INTO e2e_search_apply_receipts_v1 (generation_id,outbox_id,fencing_token,document_fingerprint,fts_fingerprint,applied_at)
+        VALUES (?,?,?,?,?,?) ON CONFLICT(generation_id) DO UPDATE SET fencing_token=excluded.fencing_token,
+        document_fingerprint=excluded.document_fingerprint,fts_fingerprint=excluded.fts_fingerprint,applied_at=excluded.applied_at`).bind(
+          g.generation_id,row.outbox_id,claimed.fencing_token,fingerprints.documentFingerprint,fingerprints.ftsFingerprint,settled),
+      core.prepare(`UPDATE e2e_generation_progress_v1 SET state='search_pending',expected_search_fingerprint=?,
+        expected_fts_fingerprint=?,last_error_code=NULL,updated_at=? WHERE generation_id=? AND state<>'completed_verified'`).bind(
+          fingerprints.documentFingerprint,fingerprints.ftsFingerprint,settled,g.generation_id),
+      core.prepare(`UPDATE e2e_search_repair_outbox_v1 SET status='pending',claimed_by=NULL,lease_expires_at=NULL,
+        last_error_code=NULL,next_attempt_at=?,updated_at=? WHERE outbox_id=?`).bind(after(settled,60),settled,row.outbox_id),
+      core.prepare("DELETE FROM e2e_commit_guards_v1 WHERE token=?").bind(token)]);
+    return { status:"awaiting_verification" } as const;
+  } catch {
+    const settled=clock(), first=claimed.first_failure_at?String(claimed.first_failure_at):settled;
+    const dead=Number(claimed.attempt_count)>=Number(claimed.max_attempts)||Date.parse(settled)-Date.parse(first)>=7200000;
+    const jitter=options.random?.()??0.5;
+    if (!Number.isFinite(jitter)||jitter<0||jitter>1) throw new Error("e2e.invalid_consumer_jitter");
+    const delay=Math.floor(Math.min(900,60*2**Math.min(Number(claimed.attempt_count)-1,10)*(0.8+0.4*jitter)));
+    const errorCode="e2e.search_processing_failed";
+    const results=await core.batch!([
+      core.prepare(`UPDATE e2e_generation_progress_v1 SET state=?,last_error_code=?,updated_at=? WHERE generation_id=?
+        AND state<>'completed_verified' AND EXISTS (SELECT 1 FROM e2e_search_repair_outbox_v1 o WHERE ${ownership})`).bind(
+          dead?"dead_letter":"retry_wait",errorCode,settled,g.generation_id,...ownershipValues(settled)),
+      core.prepare(`UPDATE e2e_search_repair_outbox_v1 AS o SET status=?,claimed_by=NULL,lease_expires_at=NULL,
+        first_failure_at=COALESCE(first_failure_at,?),next_attempt_at=?,last_error_code=?,updated_at=?
+        WHERE ${ownership} RETURNING outbox_id`).bind(dead?"dead_letter":"retry_wait",first,after(settled,delay),errorCode,settled,...ownershipValues(settled))]);
+    if (results.some(r=>r.success===false||r.error)) throw new Error("e2e.failure_record_unavailable");
+    return { status:results[1].results?.length===1?(dead?"dead_letter":"retry"):"retry" } as const;
+  }
+}
diff --git a/lib/cloudflare/e2e/search-repair-dispatcher.ts b/lib/cloudflare/e2e/search-repair-dispatcher.ts
