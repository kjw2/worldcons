diff --git a/lib/cloudflare/e2e/contracts.ts b/lib/cloudflare/e2e/contracts.ts
new file mode 100644
index 0000000..c2491c7
--- /dev/null
+++ b/lib/cloudflare/e2e/contracts.ts
@@ -0,0 +1,78 @@
+import { canonicalJson } from "@/lib/backfill/canonical-json";
+
+export const APPROVAL_HASH_SCHEMA = "worldcons.approval.v1";
+export const GENERATION_HASH_SCHEMA = "worldcons.generation.v1";
+export const PROJECTION_INPUT_SCHEMA = "worldcons.projection-input.v1";
+// Bump when FTS encoding changes independently of search_documents.
+export const FTS_INPUT_VERSION = 1;
+
+/** Explicit opt-in. Evidence is supplied by the approval owner, not invented here. */
+export interface E2EApprovalContext {
+  policyVersion: string;
+  mode: "human" | "automatic";
+  evidenceRef: string;
+  sourceEvidenceRef: string;
+  pipelineRunId?: string | null;
+  discoveryCandidateId?: string | null;
+}
+
+export interface E2EGenerationReceipt {
+  generationId: string;
+  generationSeq: number;
+  approvalKey: string;
+  approvalSnapshotHash: string;
+  projectionInputHash: string;
+  created: boolean;
+  searchRepairOutboxId?: string;
+}
+
+export function validE2EApproval(value: unknown): value is E2EApprovalContext {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const input = value as Record<string, unknown>;
+  const bounded = (field: unknown, max: number) => typeof field === "string" && field.trim().length > 0 && field.length <= max;
+  return bounded(input.policyVersion, 160)
+    && (input.mode === "human" || input.mode === "automatic")
+    && bounded(input.evidenceRef, 500) && bounded(input.sourceEvidenceRef, 500)
+    && (input.pipelineRunId == null || bounded(input.pipelineRunId, 160))
+    && (input.discoveryCandidateId == null || bounded(input.discoveryCandidateId, 160));
+}
+
+export async function sha256Canonical(value: unknown): Promise<string> {
+  const digest = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(canonicalJson(value))));
+  return [...digest].map((byte) => byte.toString(16).padStart(2, "0")).join("");
+}
+
+function json(value: unknown): unknown {
+  if (typeof value !== "string") return value ?? null;
+  return JSON.parse(value);
+}
+
+/**
+ * Immutable P3/content fields only. Operational timestamps/storage locations,
+ * retry/error metadata and actor/model accounting do not approve new content.
+ * JSON key order is ignored; arrays, body whitespace and Unicode are preserved.
+ * Missing optional role/anchor fields have the same explicit NULL as DB NULL.
+ */
+export async function approvalIdentity(articleId: string, snapshot: Record<string, unknown>, policyVersion: string) {
+  const sourceContentHash = await sha256Canonical({ schema: "worldcons.source-text.v1", cleanedText: snapshot.cleaned_text ?? null });
+  const fields = ["slug", "source_key", "jurisdiction", "institution_name", "content_type",
+    "original_language", "original_title", "korean_title", "original_published_at",
+    "original_url", "canonical_url", "cleaned_text", "case_key", "version_role",
+    "source_anchor_version_id", "enrichment_source_content_hash", "source_content_hash",
+    "authority_evidence_hash", "source_snapshot_hash", "case_metadata_snapshot", "case_identifiers_snapshot"];
+  const body: Record<string, unknown> = { schema: APPROVAL_HASH_SCHEMA, articleId, sourceContentHash };
+  for (const field of fields) body[field] = snapshot[field] ?? null;
+  body.summary_json = json(snapshot.summary_json);
+  body.source_metadata = json(snapshot.source_metadata);
+  body.case_metadata_snapshot = json(snapshot.case_metadata_snapshot);
+  body.case_identifiers_snapshot = json(snapshot.case_identifiers_snapshot);
+  const approvalSnapshotHash = await sha256Canonical(body);
+  const approvalKey = await sha256Canonical({ schema: APPROVAL_HASH_SCHEMA, articleId, sourceContentHash, approvalSnapshotHash, policyVersion });
+  return { sourceContentHash, approvalSnapshotHash, approvalKey };
+}
+
+export function approvalContextDocument(input: E2EApprovalContext) {
+  return { policyVersion: input.policyVersion, mode: input.mode, evidenceRef: input.evidenceRef,
+    sourceEvidenceRef: input.sourceEvidenceRef, pipelineRunId: input.pipelineRunId ?? null,
+    discoveryCandidateId: input.discoveryCandidateId ?? null };
+}
diff --git a/lib/cloudflare/e2e/generation-ledger.ts b/lib/cloudflare/e2e/generation-ledger.ts
new file mode 100644
index 0000000..5b4e6a5
--- /dev/null
+++ b/lib/cloudflare/e2e/generation-ledger.ts
@@ -0,0 +1,147 @@
+import { searchRepairReservation } from "./search-repair-reservation";
+import { canonicalJson } from "@/lib/backfill/canonical-json";
+import type { ArticlePublicationTransitionInput } from "@/lib/article-publication/types";
+import type { D1RuntimeDatabase, D1RuntimePreparedStatement } from "@/lib/cloudflare/d1/runtime-binding";
+import { SEARCH_PROJECTION_VERSION } from "@/lib/cloudflare/search-projection/types";
+import { APPROVAL_HASH_SCHEMA, FTS_INPUT_VERSION, GENERATION_HASH_SCHEMA, PROJECTION_INPUT_SCHEMA,
+  approvalContextDocument, approvalIdentity, sha256Canonical, type E2EGenerationReceipt } from "./contracts";
+
+type Row = Record<string, unknown>;
+// D1 limits expression depth to 100. A flat AND chain over every article
+// column can exceed that even when it stays under the parameter limit.
+// Preserve every comparison and its binding order in a balanced tree.
+function allPredicates(predicates: string[]): string {
+  if (predicates.length === 1) return predicates[0];
+  const middle = Math.floor(predicates.length / 2);
+  return `(${allPredicates(predicates.slice(0,middle))} AND ${allPredicates(predicates.slice(middle))})`;
+}
+async function read(binding: D1RuntimeDatabase, sql: string, ...values: unknown[]): Promise<Row | null> {
+  const result = await binding.prepare(sql).bind(...values).all<Row>();
+  if (result.success === false || result.error) throw new Error("e2e.read_failed");
+  return result.results?.[0] ?? null;
+}
+
+// SQL serializes sorted tags; these exact bytes are asserted INSIDE the commit.
+// Tags can change without articles.updated_at changing.
+const TAG_SNAPSHOT_SQL = `SELECT json_group_array(json_object(
+  'tag_id',tag_id,'confidence',confidence,'slug',slug,'name',name,
+  'normalized_name',normalized_name,'type',type)) AS snapshot FROM (
+  SELECT at.tag_id,at.confidence,t.slug,t.name,t.normalized_name,t.type
+  FROM article_tags at LEFT JOIN tags t ON t.id=at.tag_id
+  WHERE at.article_id=? ORDER BY at.tag_id COLLATE BINARY)`;
+
+export async function readGenerationReplay(binding: D1RuntimeDatabase, input: ArticlePublicationTransitionInput) {
+  if (!input.e2eApproval) return undefined;
+  const row = await read(binding, `SELECT g.*,r.context_hash,r.generation_created,o.outbox_id
+    FROM e2e_generation_requests_v1 r JOIN e2e_generations_v1 g ON g.generation_id=r.generation_id
+    LEFT JOIN e2e_search_repair_outbox_v1 o ON o.article_id=g.article_id AND o.generation_id=g.generation_id
+    WHERE r.article_id=? AND r.idempotency_key=?`, input.articleId, input.idempotencyKey);
+  const contextHash = await sha256Canonical(approvalContextDocument(input.e2eApproval));
+  if (!row || row.context_hash !== contextHash || row.expected_publication_state !== input.targetState) {
+    throw new Error("e2e.invalid_replay");
+  }
+  return receipt(row, Number(row.generation_created) === 1);
+}
+
+function receipt(row: Row, created: boolean): E2EGenerationReceipt {
+  return { generationId: String(row.generation_id), generationSeq: Number(row.generation_seq),
+    approvalKey: String(row.approval_key), approvalSnapshotHash: String(row.approval_snapshot_hash),
+    projectionInputHash: String(row.projection_input_hash), created,
+    ...(row.outbox_id ? { searchRepairOutboxId: String(row.outbox_id) } : {}) };
+}
+
+export async function prepareGenerationCommit(binding: D1RuntimeDatabase, input: ArticlePublicationTransitionInput,
+  observed: { article: Row; p3Head: Row | null; v4Head: Row | null; publication: Row | null },
+  committed: { version: Row; publicationId: string; publicationRevision: number; now: string }) {
+  const approval = input.e2eApproval!;
+  const { article, p3Head, v4Head, publication } = observed;
+  const { version, publicationId, publicationRevision, now } = committed;
+  const previous = await read(binding, `SELECT g.* FROM e2e_generation_heads_v1 h
+    JOIN e2e_generations_v1 g ON g.generation_id=h.generation_id AND g.article_id=h.article_id
+    WHERE h.article_id=?`, input.articleId);
+  const tagSnapshot = String((await read(binding, TAG_SNAPSHOT_SQL, input.articleId))?.snapshot ?? "[]");
+  const identity = await approvalIdentity(input.articleId, version, approval.policyVersion);
+  const projectionInputHash = await sha256Canonical({ schema: PROJECTION_INPUT_SCHEMA,
+    articleId: input.articleId, versionId: version.id, versionRevision: Number(version.revision),
+    approvalSnapshotHash: identity.approvalSnapshotHash, publicationId, publicationRevision,
+    publicationState: input.targetState, tags: JSON.parse(tagSnapshot), reviewState: article.review_state ?? null,
+    projectionVersion: SEARCH_PROJECTION_VERSION, ftsInputVersion: FTS_INPUT_VERSION });
+  const created = !previous || previous.approval_key !== identity.approvalKey
+    || previous.projection_input_hash !== projectionInputHash;
+  const seq = previous ? Number(previous.generation_seq) + Number(created) : 1;
+  if (!Number.isSafeInteger(seq) || seq < 1) throw new Error("e2e.invalid_sequence");
+  const generationId = created ? await sha256Canonical({ schema: GENERATION_HASH_SCHEMA,
+    articleId: input.articleId, generationSeq: seq, approvalKey: identity.approvalKey,
+    expectedVersionId: version.id, targetState: input.targetState, projectionInputHash }) : String(previous!.generation_id);
+  const result: E2EGenerationReceipt = { generationId, generationSeq: seq,
+    approvalKey: identity.approvalKey, approvalSnapshotHash: identity.approvalSnapshotHash, projectionInputHash, created };
+  const token = crypto.randomUUID();
+  const predicates: string[] = [];
+  const values: unknown[] = [token];
+  // Names come from DB SELECT *, never request input. Even operational fields
+  // are compared: content hash equality does not waive snapshot freshness.
+  const columns = Object.keys(article);
+  if (columns.some((column) => !/^[a-z_][a-z0-9_]*$/.test(column))) throw new Error("e2e.invalid_column");
+  predicates.push(`EXISTS (SELECT 1 FROM articles WHERE ${allPredicates(columns.map((column) => '"'+column+'" IS ?'))})`);
+  values.push(...columns.map((column) => article[column] ?? null));
+  for (const [table, row, fields] of [
+    ["article_version_heads_p3",p3Head,["current_version_id","current_revision"]],
+    ["article_revision_heads_v4",v4Head,["current_version_id","current_revision"]],
+    ["article_publications_p3",publication,["id","state","version_id","revision"]],
+  ] as const) {
+    predicates.push(`COALESCE((SELECT json_array(${fields.join(',')}) FROM ${table} WHERE article_id=?),'null')=?`);
+    values.push(input.articleId, row ? JSON.stringify(fields.map((field) => row[field] ?? null)) : "null");
+  }
+  predicates.push("COALESCE((SELECT json_array(generation_id,generation_seq) FROM e2e_generation_heads_v1 WHERE article_id=?),'null')=?");
+  values.push(input.articleId, previous ? JSON.stringify([previous.generation_id,previous.generation_seq]) : "null");
+  predicates.push(`(${TAG_SNAPSHOT_SQL.replace(' AS snapshot','')})=?`);
+  values.push(input.articleId, tagSnapshot);
+  // Fail before writes if future schema exceeds D1's 100-parameter budget.
+  if (values.length > 100) throw new Error("e2e.guard_parameter_budget");
+  const guard = binding.prepare(`INSERT INTO e2e_commit_guards_v1 (token,assertion)
+    VALUES (?,CASE WHEN ${allPredicates(predicates)} THEN 1 ELSE 0 END)`).bind(...values);
+  const statements: D1RuntimePreparedStatement[] = [];
+  if (created) {
+    statements.push(binding.prepare(`INSERT INTO e2e_generations_v1
+      (generation_id,article_id,generation_seq,source_key,source_content_hash,approval_key,
+       approval_snapshot_hash,approval_hash_schema,projection_input_hash,projection_input_schema,
+       expected_version_id,expected_version_revision,expected_publication_id,expected_publication_revision,
+       expected_publication_state,approval_mode,policy_version,approval_evidence_ref,source_evidence_ref,
+       pipeline_run_id,discovery_candidate_id,created_at)
+      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).bind(
+      generationId,input.articleId,seq,version.source_key,identity.sourceContentHash,identity.approvalKey,
+      identity.approvalSnapshotHash,APPROVAL_HASH_SCHEMA,projectionInputHash,PROJECTION_INPUT_SCHEMA,
+      version.id,Number(version.revision),publicationId,publicationRevision,input.targetState,approval.mode,
+      approval.policyVersion,approval.evidenceRef,approval.sourceEvidenceRef,approval.pipelineRunId ?? null,
+      approval.discoveryCandidateId ?? null,now));
+    statements.push(binding.prepare(`INSERT INTO e2e_generation_heads_v1 (article_id,generation_id,generation_seq,updated_at)
+      VALUES (?,?,?,?) ON CONFLICT(article_id) DO UPDATE SET generation_id=excluded.generation_id,
+      generation_seq=excluded.generation_seq,updated_at=excluded.updated_at
+      WHERE e2e_generation_heads_v1.generation_id=? AND e2e_generation_heads_v1.generation_seq=?`).bind(
+      input.articleId,generationId,seq,now,previous?.generation_id ?? "",previous?.generation_seq ?? 0));
+    statements.push(binding.prepare(`INSERT INTO e2e_generation_progress_v1 (generation_id,state,updated_at)
+      VALUES (?,'publication_committed',?)`).bind(generationId,now));
+  }
+  statements.push(binding.prepare(`INSERT INTO e2e_generation_requests_v1
+    (article_id,idempotency_key,generation_id,context_hash,context_document,generation_created) VALUES (?,?,?,?,?,?)`).bind(
+    input.articleId,input.idempotencyKey,generationId,await sha256Canonical(approvalContextDocument(approval)),canonicalJson(approvalContextDocument(approval)),Number(created)));
+  const reservation = await searchRepairReservation(binding, { articleId: input.articleId,
+    generationId,generationSeq: seq,versionId: String(version.id),versionRevision: Number(version.revision),
+    publicationId,publicationRevision,publicationState: input.targetState,policyVersion: approval.policyVersion,
+    projectionInputHash,evidenceRef: created ? approval.evidenceRef : String(previous!.approval_evidence_ref) }, now);
+  statements.push(reservation.insert);
+  result.searchRepairOutboxId = reservation.outboxId;
+  if (created && previous) {
+    // Break both transport and Consumer ownership of old work in the SAME
+    // publication commit. Preserve verified rows/evidence as historical proof.
+    statements.push(binding.prepare(`UPDATE e2e_search_repair_outbox_v1 SET status='superseded',
+      fencing_token=fencing_token+1,dispatch_fence=dispatch_fence+1,
+      claimed_by=NULL,lease_expires_at=NULL,dispatch_owner=NULL,dispatch_token=NULL,
+      dispatch_lease_expires_at=NULL,last_error_code='e2e.generation_replaced',updated_at=?
+      WHERE article_id=? AND generation_id<>? AND status NOT IN ('verified','superseded')`).bind(now,input.articleId,generationId));
+    statements.push(binding.prepare(`UPDATE e2e_generation_progress_v1 SET state='superseded',updated_at=?
+      WHERE generation_id=? AND state<>'completed_verified'`).bind(now,previous.generation_id));
+  }
+  const cleanup = binding.prepare("DELETE FROM e2e_commit_guards_v1 WHERE token=?").bind(token);
+  return { result, guard, statements, cleanup };
+}
diff --git a/lib/cloudflare/e2e/search-repair-dispatcher.ts b/lib/cloudflare/e2e/search-repair-dispatcher.ts
new file mode 100644
index 0000000..8ff0549
--- /dev/null
+++ b/lib/cloudflare/e2e/search-repair-dispatcher.ts
@@ -0,0 +1,183 @@
+import type { D1RuntimeDatabase, D1RuntimePreparedStatement, D1RuntimeResult } from "@/lib/cloudflare/d1/runtime-binding";
+import { searchRepairReservation } from "./search-repair-reservation";
+
+export interface SearchRepairMessage { schemaVersion: 1; type: "e2e-search-repair"; outboxId: string }
+export interface SearchRepairQueue { send(body: SearchRepairMessage): Promise<unknown> }
+export interface SearchRepairDispatchOptions {
+  limit?: number;
+  workerId?: string;
+  clock?: () => string;
+  random?: () => number;
+}
+type Row = Record<string, unknown>;
+const LEASE_SECONDS = 300;
+const REDISPATCH_SECONDS = 60;
+const MAX_TRANSPORT_FAILURES = 8;
+const TRANSPORT_BUDGET_MS = 120 * 60 * 1000;
+
+export function isSearchRepairMessage(value: unknown): value is SearchRepairMessage {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const body = value as Row;
+  return body.schemaVersion === 1 && body.type === "e2e-search-repair"
+    && typeof body.outboxId === "string" && /^[0-9a-f]{64}$/.test(body.outboxId)
+    && Object.keys(body).every((key) => ["schemaVersion", "type", "outboxId"].includes(key));
+}
+
+async function rows(db: D1RuntimeDatabase, sql: string, ...values: unknown[]): Promise<Row[]> {
+  const result = await db.prepare(sql).bind(...values).all<Row>();
+  if (result.success === false || result.error || !Array.isArray(result.results)) throw new Error("e2e.dispatch_read_failed");
+  return result.results;
+}
+async function batch(db: D1RuntimeDatabase, statements: D1RuntimePreparedStatement[]): Promise<D1RuntimeResult[]> {
+  if (!db.batch) throw new Error("e2e.dispatch_batch_unavailable");
+  const result = await db.batch(statements);
+  for (const entry of result) {
+    if (entry.error?.includes("e2e_commit_snapshot_match")) throw new Error("e2e_commit_snapshot_match");
+    if (entry.success === false || entry.error) throw new Error("e2e.dispatch_batch_failed");
+  }
+  return result;
+}
+function iso(value: string) {
+  const time = Date.parse(value);
+  if (!Number.isFinite(time)) throw new Error("e2e.invalid_dispatch_clock");
+  return new Date(time).toISOString();
+}
+function after(now: string, seconds: number) { return new Date(Date.parse(now) + seconds * 1000).toISOString(); }
+function limit(value = 25) {
+  if (!Number.isSafeInteger(value) || value < 1 || value > 50) throw new Error("e2e.invalid_dispatch_limit");
+  return value;
+}
+
+// g and h are immutable generation/current-head aliases. Mutable input/quality
+// revalidation and Search-side fencing belong to M3/M4, never to Queue ACK.
+const CURRENT_GENERATION_SQL = `h.generation_id=g.generation_id AND h.generation_seq=g.generation_seq
+  AND EXISTS (SELECT 1 FROM article_publications_p3 p WHERE p.article_id=g.article_id
+    AND p.id=g.expected_publication_id AND p.version_id=g.expected_version_id
+    AND CAST(p.revision AS INTEGER)=g.expected_publication_revision AND p.state=g.expected_publication_state)
+  AND EXISTS (SELECT 1 FROM article_version_heads_p3 vh WHERE vh.article_id=g.article_id
+    AND vh.current_version_id=g.expected_version_id AND CAST(vh.current_revision AS INTEGER)=g.expected_version_revision)
+  AND (NOT EXISTS (SELECT 1 FROM article_revision_heads_v4 v4 WHERE v4.article_id=g.article_id)
+    OR EXISTS (SELECT 1 FROM article_revision_heads_v4 v4 WHERE v4.article_id=g.article_id
+      AND v4.current_version_id=g.expected_version_id AND CAST(v4.current_revision AS INTEGER)=g.expected_version_revision))`;
+const CURRENT_OUTBOX_SQL = `EXISTS (SELECT 1 FROM e2e_generations_v1 g
+  JOIN e2e_generation_heads_v1 h ON h.article_id=g.article_id
+  WHERE g.generation_id=o.generation_id AND g.article_id=o.article_id AND ${CURRENT_GENERATION_SQL}
+    AND g.generation_seq=o.generation_seq AND g.expected_version_id=o.expected_version_id
+    AND g.expected_version_revision=o.expected_version_revision AND g.expected_publication_id=o.expected_publication_id
+    AND g.expected_publication_revision=o.expected_publication_revision AND g.expected_publication_state=o.expected_publication_state
+    AND g.policy_version=o.policy_version AND g.projection_input_hash=o.projection_input_hash)`;
+const DUE_SQL = `(o.status IN ('pending','retry_wait') OR (o.status='leased' AND o.lease_expires_at<=?))
+  AND o.next_attempt_at<=? AND o.next_dispatch_at<=?
+  AND (o.dispatch_token IS NULL OR o.dispatch_lease_expires_at<=?)`;
+
+/** Repairs M1 upgrade holes; never fabricates a new generation or publication. */
+export async function reconcileMissingSearchRepairs(db: D1RuntimeDatabase, options: SearchRepairDispatchOptions = {}) {
+  const now = iso(options.clock?.() ?? new Date().toISOString());
+  const candidates = await rows(db, `SELECT g.* FROM e2e_generations_v1 g
+    JOIN e2e_generation_heads_v1 h ON h.article_id=g.article_id
+    WHERE ${CURRENT_GENERATION_SQL}
+      AND NOT EXISTS (SELECT 1 FROM e2e_search_repair_outbox_v1 o WHERE o.generation_id=g.generation_id)
+    ORDER BY g.created_at,g.article_id LIMIT ?`, limit(options.limit));
+  let reservedCount = 0, conflictCount = 0;
+  for (const g of candidates) {
+    const reservation = await searchRepairReservation(db, { articleId: String(g.article_id),
+      generationId: String(g.generation_id),generationSeq: Number(g.generation_seq),versionId: String(g.expected_version_id),
+      versionRevision: Number(g.expected_version_revision),publicationId: String(g.expected_publication_id),
+      publicationRevision: Number(g.expected_publication_revision),publicationState: String(g.expected_publication_state),
+      policyVersion: String(g.policy_version),projectionInputHash: String(g.projection_input_hash),
+      evidenceRef: String(g.approval_evidence_ref) }, now);
+    const token = crypto.randomUUID();
+    try {
+      const results = await batch(db, [db.prepare(`INSERT INTO e2e_commit_guards_v1 (token,assertion)
+        VALUES (?,CASE WHEN EXISTS (SELECT 1 FROM e2e_generations_v1 g
+          JOIN e2e_generation_heads_v1 h ON h.article_id=g.article_id
+          WHERE g.generation_id=? AND ${CURRENT_GENERATION_SQL}) THEN 1 ELSE 0 END)`).bind(token,g.generation_id),
+        reservation.insert, db.prepare("DELETE FROM e2e_commit_guards_v1 WHERE token=?").bind(token)]);
+      reservedCount += Number(results[1].meta?.changes ?? 0);
+    } catch (error) {
+      if (!(error instanceof Error) || !error.message.includes("e2e_commit_snapshot_match")) throw error;
+      conflictCount++;
+    }
+  }
+  return { reservedCount, conflictCount };
+}
+
+/** Send only durable identity. Accepted-but-unrecorded sends may be repeated. */
+export async function dispatchSearchRepairs(db: D1RuntimeDatabase, queue: SearchRepairQueue, options: SearchRepairDispatchOptions = {}) {
+  const clock = () => iso(options.clock?.() ?? new Date().toISOString());
+  const now = clock();
+  const owner = options.workerId ?? `e2e-dispatch:${crypto.randomUUID()}`;
+  if (!owner.trim() || owner.length > 160) throw new Error("e2e.invalid_dispatch_owner");
+  const candidates = await rows(db, `SELECT o.outbox_id FROM e2e_search_repair_outbox_v1 o
+    WHERE ${DUE_SQL} AND ${CURRENT_OUTBOX_SQL}
+    ORDER BY o.next_dispatch_at,o.created_at,o.outbox_id LIMIT ?`, now,now,now,now,limit(options.limit));
+  let claimedCount = 0, sentCount = 0, failedCount = 0, deadLetterCount = 0, fencedCount = 0;
+  for (const candidate of candidates) {
+    const claimedAt = clock(), token = crypto.randomUUID();
+    const claimed = await rows(db, `UPDATE e2e_search_repair_outbox_v1 AS o SET
+      dispatch_owner=?,dispatch_token=?,dispatch_lease_expires_at=?,dispatch_fence=dispatch_fence+1,
+      dispatch_count=dispatch_count+1,updated_at=? WHERE outbox_id=? AND ${DUE_SQL} AND ${CURRENT_OUTBOX_SQL}
+      RETURNING *`, owner,token,after(claimedAt,LEASE_SECONDS),claimedAt,candidate.outbox_id,
+      claimedAt,claimedAt,claimedAt,claimedAt);
+    if (claimed.length !== 1) continue;
+    claimedCount++;
+    const row = claimed[0];
+    let sendFailed = false;
+    try { await queue.send({ schemaVersion: 1,type: "e2e-search-repair",outboxId: String(row.outbox_id) }); }
+    catch { sendFailed = true; } // Provider error text/body is not persisted.
+    const settledAt = clock();
+    const failures = Number(row.dispatch_failure_count) + Number(sendFailed);
+    const firstFailure = row.first_dispatch_failure_at ? String(row.first_dispatch_failure_at) : settledAt;
+    const dead = sendFailed && (failures >= MAX_TRANSPORT_FAILURES
+      || Date.parse(settledAt) - Date.parse(firstFailure) >= TRANSPORT_BUDGET_MS);
+    const jitter = options.random?.() ?? crypto.getRandomValues(new Uint32Array(1))[0] / 2 ** 32;
+    if (!Number.isFinite(jitter) || jitter < 0 || jitter > 1) throw new Error("e2e.invalid_dispatch_jitter");
+    const delay = Math.floor(Math.min(900,60 * 2 ** Math.min(failures - 1,10) * (0.8 + 0.4 * jitter)));
+    const retryAt = after(settledAt,sendFailed ? delay : REDISPATCH_SECONDS);
+    const errorCode = sendFailed ? "e2e.queue_send_failed" : null;
+    // Every transition checks owner, token, numeric fence, unexpired lease,
+    // current Core identity and nonterminal status. A send is never a verify.
+    const ownership = `o.outbox_id=? AND o.dispatch_owner=? AND o.dispatch_token=? AND o.dispatch_fence=?
+      AND o.dispatch_lease_expires_at>? AND o.status IN ('pending','retry_wait','leased')
+      AND (?=0 OR o.status<>'leased' OR o.lease_expires_at<=?) AND ${CURRENT_OUTBOX_SQL}`;
+    const ownershipValues = [row.outbox_id,owner,token,row.dispatch_fence,settledAt,Number(sendFailed),settledAt];
+    // Both statements assert the original ownership. Update progress before
+    // releasing transport ownership inside the same atomic batch, so a stale
+    // sender cannot update progress merely because another worker cleared it.
+    const results = await batch(db, [
+      db.prepare(`UPDATE e2e_generation_progress_v1 SET state=?,last_error_code=?,updated_at=?
+        WHERE generation_id=? AND state IN ('publication_committed','search_pending','retry_wait')
+          AND EXISTS (SELECT 1 FROM e2e_search_repair_outbox_v1 o WHERE ${ownership})`).bind(
+        dead ? "dead_letter" : sendFailed ? "retry_wait" : "search_pending",errorCode,settledAt,
+        row.generation_id,...ownershipValues),
+      db.prepare(`UPDATE e2e_search_repair_outbox_v1 AS o SET
+        dispatch_owner=NULL,dispatch_token=NULL,dispatch_lease_expires_at=NULL,
+        dispatch_failure_count=?,first_dispatch_failure_at=?,next_dispatch_at=?,
+        dispatched_at=CASE WHEN ?=0 THEN ? ELSE dispatched_at END,last_dispatch_error_code=?,
+        status=CASE WHEN ?=1 THEN 'dead_letter' ELSE status END,updated_at=?
+        WHERE ${ownership} RETURNING outbox_id`).bind(
+        sendFailed ? failures : 0,sendFailed ? firstFailure : null,retryAt,Number(sendFailed),settledAt,
+        errorCode,Number(dead),settledAt,...ownershipValues)]);
+    if (results[1].results?.length !== 1) { fencedCount++; continue; }
+    if (sendFailed) { failedCount++; if (dead) deadLetterCount++; } else sentCount++;
+  }
+  return { claimedCount,sentCount,failedCount,deadLetterCount,fencedCount };
+}
+
+export async function readSearchRepairHealth(db: D1RuntimeDatabase, now = new Date().toISOString()) {
+  const outstanding = await rows(db, `SELECT COUNT(*) AS pending_count,MIN(o.created_at) AS oldest_at,
+      COALESCE(SUM(CASE WHEN o.dispatch_failure_count>=3 THEN 1 ELSE 0 END),0) AS repeated_failure_count,
+      COALESCE(SUM(CASE WHEN ${CURRENT_OUTBOX_SQL} THEN 0 ELSE 1 END),0) AS core_drift_count
+    FROM e2e_search_repair_outbox_v1 o JOIN e2e_generation_heads_v1 h ON h.generation_id=o.generation_id
+    WHERE o.status NOT IN ('verified','superseded','dead_letter')`);
+  const dead = await rows(db, "SELECT COUNT(*) AS count FROM e2e_search_repair_outbox_v1 WHERE status='dead_letter'");
+  const missing = await rows(db, `SELECT COUNT(*) AS count FROM e2e_generation_heads_v1 h
+    WHERE NOT EXISTS (SELECT 1 FROM e2e_search_repair_outbox_v1 o WHERE o.generation_id=h.generation_id)`);
+  const row = outstanding[0];
+  const ageSeconds = row.oldest_at ? Math.max(0,Math.floor((Date.parse(iso(now)) - Date.parse(String(row.oldest_at))) / 1000)) : 0;
+  return { pendingCount: Number(row.pending_count),oldestPendingAgeSeconds: ageSeconds,
+    repeatedFailureCount: Number(row.repeated_failure_count),coreIdentityDriftCount: Number(row.core_drift_count),
+    deadLetterCount: Number(dead[0].count),missingReservationCount: Number(missing[0].count),
+    requiresAttention: ageSeconds >= 1800 || Number(row.repeated_failure_count) > 0 || Number(row.core_drift_count) > 0
+      || Number(dead[0].count) > 0 || Number(missing[0].count) > 0 };
+}
