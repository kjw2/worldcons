# Vercel Private Blob artifact externalization (M1-M3). Write requires read to be
# enabled. When read is enabled the service dual-reads inline and Blob-backed
# fetch/normalization artifacts with size and SHA-256 checks. Keep both false by default.
CASE_BACKFILL_ARTIFACT_BLOB_WRITE_ENABLED=false
CASE_BACKFILL_ARTIFACT_BLOB_READ_ENABLED=false
# M4A backfills existing inline fetch/normalization artifacts onto private Blob.
# Run it as a dry run first (default), then add --execute to attach refs. It needs
# the Blob credentials above, uploads and verifies size + SHA-256 before mutating,
# preserves inline content, and is idempotent on rerun:
#   pnpm externalize:artifacts --kind=fetch --source=<source-key> --batch-size=25
#   pnpm externalize:artifacts --kind=fetch --source=<source-key> --execute
# M4B clears the now-redundant inline fetch/normalization payload only after M4A has
# externalized it. It defaults to a dry run, requires an explicit
# --acknowledge-irreversible together with --execute, requires
# CASE_BACKFILL_ARTIFACT_BLOB_READ_ENABLED=true, and verifies each Blob object's
# exact size and SHA-256 plus valid JSON before the DB row is cleared. It never
# deletes Blob objects and is idempotent on rerun:
#   pnpm clear:inline-artifacts --kind=fetch --source=<source-key> --batch-size=25
#   pnpm clear:inline-artifacts --kind=fetch --source=<source-key> --execute --acknowledge-irreversible
# M5 read-only artifact Blob readiness/observability. Reports aggregate-only
# fetch/normalization presence, externalization, metadata, and ledger coverage
# with derived NEW_WRITE_READY / INLINE_CLEAR_READY gates. It is read-only, takes
# no write flags, and performs zero Blob reads by default. Optional bounded Blob
# verification (--verify-sample=N, off by default) also requires the Blob read
# flag, and reports aggregate counts only:
#   pnpm readiness:artifact-blob
#   pnpm readiness:artifact-blob --source=<source-key> --kind=fetch
#   pnpm readiness:artifact-blob --source=<source-key> --verify-sample=10 --require-inline-clear-ready
# Both flags below stay false; after a real inline clear, restoring inline storage
# requires a separately designed restore path (not implemented).
# Vercel Blob private store credentials. The SDK reads these from the environment;
# never store their values, signed URLs, or object tokens in the database.
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=   # injected and rotated by Vercel; never commit a value
# BLOB_READ_WRITE_TOKEN=   # only needed when running outside Vercel
# Artifact Blob transport provider. Defaults to "vercel" (current behavior is
# unchanged). M1 Cloudflare migration uses "r2" for new private artifact/raw
# externalization. Supabase Storage remains a temporary compatibility provider.
# Allowed values: vercel | supabase | r2.
# ARTIFACT_BLOB_PROVIDER=vercel
# Private object bucket. Defaults to worldcons-artifacts. For Supabase this is a
# private Storage bucket. For R2 it is the private R2 bucket addressed by the S3
# endpoint or injected Worker R2Bucket binding. No bucket is created automatically.
# ARTIFACT_BLOB_BUCKET=worldcons-artifacts
# Node/CLI R2 access. Keep all values server-side. R2_ENDPOINT may be supplied
# explicitly; otherwise R2_ACCOUNT_ID derives
# https://<account-id>.r2.cloudflarestorage.com. Region defaults to auto.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# Operator-only migration bridge. When ARTIFACT_BLOB_PROVIDER=r2, setting this to
# "wrangler" makes Node maintenance CLIs use the locally authenticated Wrangler
# OAuth session instead of S3 credentials. This is for bounded migration/backfill
# operations only; application runtime code does not use this transport.
# ARTIFACT_BLOB_R2_OPERATOR_TRANSPORT=wrangler
# Optional absolute Wrangler executable/shim path for operator migration CLIs.
# On Windows the default is %APPDATA%\npm\wrangler.cmd so pnpm/tsx cannot
# accidentally resolve a stale local node_modules shim.
# WORLDCONS_WRANGLER_BIN=
# Ordered read-only fallback providers, comma separated. Example for new R2 writes
# while legacy Vercel refs still exist: vercel. Fallback is consulted ONLY after an
# unambiguous object-level not-found. Bucket/auth/signature/network/rate/5xx errors
# fail closed. Writes always go to the primary provider only.
# ARTIFACT_BLOB_READ_FALLBACK_PROVIDERS=vercel
# Legacy compatibility flag. When true and no explicit fallback list is supplied,
# a non-Vercel primary falls back to Vercel on object-not-found only.
# ARTIFACT_BLOB_READ_FALLBACK_ENABLED=false
# WARNING: Vercel Blob Hobby "Advanced Operations" are capped (2,000/month). Hitting
# the cap can suspend the store so that reads AND writes fail, with no overage
# billing and no self-serve recovery. M1 therefore moves new externalization work to
# ARTIFACT_BLOB_PROVIDER=r2 after a bounded R2 canary. Keep the Vercel store only as
# a not-found-only legacy read fallback. Never repoint existing storageRef values;
# they are content addressed.
# M6A article raw_text private Blob externalization. READ enables dual-read
# hydration of externalized raw_text on article detail reads; WRITE enables the
# flag-on capture that uploads raw_text to private Blob before the publication RPC.
# WRITE requires READ, and both stay false by default.
ARTICLE_RAW_BLOB_READ_ENABLED=false
ARTICLE_RAW_BLOB_WRITE_ENABLED=false
# M6B backfills existing inline article raw_text onto private Blob by attaching a
# verified content-addressed ref while preserving inline raw_text, for both the
# articles table and article_content_versions_p3. It needs the Blob credentials
# above, uploads and verifies size + SHA-256 before the permit-guarded attach, is
# idempotent on rerun, and never clears inline raw_text. Executing also requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true and an explicit --acknowledge-externalization;
# a dry run requires neither and WRITE is never required. On the articles table the
# attach advances the row's existing updated_at, so use bounded batches away from
# concurrent publication edits:
#   pnpm externalize:article-raw --table=articles --source=<source-key> --batch-size=25
#   pnpm externalize:article-raw --table=articles --source=<source-key> --execute --acknowledge-externalization
# M6C clears the now-redundant inline article raw_text only after M6A/M6B have
# attached and ledgered the verified content-addressed Blob metadata. It defaults to
# a dry run that performs zero Blob reads and zero DB mutation, requires an explicit
# --acknowledge-inline-clear together with --execute, requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true, and nowhere requires WRITE. Execute verifies
# each Blob object's exact size and SHA-256, decodes the stored JSON string, and
# requires the decoded text to exactly equal the row's current inline raw_text before
# the clear RPC runs. It never writes or deletes a Blob object and is idempotent on
# rerun. WARNING: clearing an `articles` row advances its existing updated_at, so run
# bounded batches away from concurrent publication edits:
#   pnpm clear:article-raw-inline --table=articles --source=<source-key> --batch-size=25
#   pnpm clear:article-raw-inline --table=articles --source=<source-key> --execute --acknowledge-inline-clear
# M6E article raw_text inline restore, the only supported way to put a cleared inline
# raw_text back from its verified private Blob copy, for both the articles table and
# article_content_versions_p3. It defaults to a dry run that performs zero Blob reads
# and zero DB mutation and classifies candidates as planned/conflict/not-ready,
# requires an explicit --acknowledge-inline-restore together with --execute, requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true, and nowhere requires WRITE. Execute verifies each
# Blob object's exact size and SHA-256 and decodes the stored JSON string, then calls
# the restore RPC with the decoded text and the exact recorded metadata; the database
# recomputes the JSON-string document size and SHA-256 and requires them to equal the
# recorded size/hash. It never writes or deletes a Blob object and is idempotent on
# rerun. Run a tiny restore canary first, and only do a large-scale M6C inline clear
# after M6E has been deployed and tested. No VACUUM FULL and no pg_repack. Restoring an
# `articles` row advances its existing updated_at, so use bounded batches away from
# concurrent publication edits:
#   pnpm restore:article-raw-inline --table=articles --source=<source-key> --batch-size=25
#   pnpm restore:article-raw-inline --table=articles --source=<source-key> --batch-size=1 --execute --acknowledge-inline-restore
ADMIN_P5_COMPATIBILITY_OBSERVATION_ENABLED=false
ADMIN_P5_COMPATIBILITY_OBSERVATION_SAMPLE_RATE=0.1
ADMIN_P5_GOVERNANCE_UI_ENABLED=false
ADMIN_P5_HEALTH_VERIFICATION_ENABLED=false
# M11.3 ops-heartbeat write authority. Default "supabase" preserves the existing
# ops_workflow_heartbeat_v1 RPC path for Node/GitHub callers. "d1-canary" routes
# only the explicit m11 canary run id to Cloudflare D1, and "d1" routes every
# heartbeat to D1. Non-supabase modes deliver over the publicly reachable but
# authenticated worldcons-ops-write boundary (HTTPS + OIDC) and fail closed;
# they never fall back to a second writer. Do not set this without the boundary
# URL below.
#
# This Node-side authority must be deliberately coordinated with the boundary
# Worker's own WORLDCONS_OPS_HEARTBEAT_WRITE_AUTHORITY var: enabling d1-canary/d1
# here is only meaningful when the boundary is set to the same mode. If they
# disagree, the Node client still sends and the boundary applies its own var
# (an unset boundary var stays "supabase" and relays to the Supabase bridge).
# Leaving both at the default "supabase" sends nothing to the boundary.
WORLDCONS_OPS_HEARTBEAT_WRITE_AUTHORITY=supabase
# Node/GitHub client target for the worldcons-ops-write boundary. Only consulted
# when the authority above is d1-canary/d1. Keep it server-side.
#
# M11.3-OIDC dual trust model. GitHub Actions GitHub-hosted workflows no longer
# use a shared repository secret. Each heartbeat-producing workflow grants
# `id-token: write` and the Node client requests a short-lived GitHub Actions
# OIDC JWT for the dedicated audience at runtime; the boundary verifies it
# (exact issuer, dedicated audience, repository kjw2/worldcons, bound
# workflow_ref/ref, exp/nbf/iat, single-use jti) and never sees a shared secret.
# OPS_WRITE_TOKEN is therefore OPTIONAL and no longer required for the first
# Worker creation or for GitHub-hosted heartbeat auth. If an operator wants to
# keep bearer access for non-GitHub canary calls, set the Worker secret
# OPS_WRITE_TOKEN and the matching WORLDCONS_OPS_WRITE_TOKEN here (or pass an
# explicit WORLDCONS_OPS_WRITE_OIDC_TOKEN for a one-off). Never commit any value.
#
# In GitHub Actions the heartbeat-producing workflows (crawlee-worker,
# summary-drain, embedding-backfill, admin-watchdog, admin-command-worker-p1)
# inject as:
#   WORLDCONS_OPS_HEARTBEAT_WRITE_AUTHORITY: ${{ vars.WORLDCONS_OPS_HEARTBEAT_WRITE_AUTHORITY || 'supabase' }}
#   WORLDCONS_OPS_WRITE_BASE_URL:          ${{ vars.WORLDCONS_OPS_WRITE_BASE_URL }}
#   WORLDCONS_OPS_HEARTBEAT_OIDC_AUDIENCE: ${{ vars.WORLDCONS_OPS_HEARTBEAT_OIDC_AUDIENCE || 'worldcons-ops-write' }}
# The audience is a non-secret repository variable. Leaving the authority unset
# keeps the resting "supabase" mode.
# WORLDCONS_OPS_WRITE_BASE_URL=
# WORLDCONS_OPS_HEARTBEAT_OIDC_AUDIENCE=worldcons-ops-write
#
# M11.3 live D1 canary selector (optional, inert when unset). A real
# GitHub/Node heartbeat derives run_id from GITHUB_RUN_ID and cannot be forced to
# the fixed literal m11-ops-heartbeat-canary, so the boundary d1-canary selector
# also accepts an explicit bounded detail marker. Set this to this run's exact id
# to make the Node writer add detail.m11OpsHeartbeatCanary=true while run_id stays
# the real GitHub run id. The admin-watchdog workflow pins this to
# ${{ github.run_id }} only for a manual dispatch with ops_heartbeat_canary=true;
# there is deliberately no shared repo-var fallback, so a lingering value can
# never select an unrelated run. Unset it in the resting state; ordinary runs
# never emit the marker.
# WORLDCONS_OPS_HEARTBEAT_CANARY_MARKER=
# Optional operator/legacy shared bearer (must equal the Worker's OPS_WRITE_TOKEN):
# WORLDCONS_OPS_WRITE_TOKEN=
# Optional explicit OIDC JWT for a non-Actions one-off (never commit):
# WORLDCONS_OPS_WRITE_OIDC_TOKEN=
# M11.3R ops-heartbeat read authority. This is resolved separately from the
# write authority above, so a staging write canary never changes what a reader
# sees. Default "supabase" preserves the resting getWorkflowHeartbeats read
# (used by lib/ops/watchdog.ts and app/api/masterdash/health/route.ts) exactly.
# "d1" selects the migrated worldcons_ops read and FAILS CLOSED when the read
# boundary is unavailable; it never silently falls back to Supabase. There is
# deliberately no d1-canary read mode. Reads travel over the same
# authenticated worldcons-ops-write boundary using the same base URL and GitHub
# OIDC audience as the write path (no shared token required).
#
# GitHub Actions watchdog/ops jobs inject this as:
#   WORLDCONS_OPS_HEARTBEAT_READ_AUTHORITY: ${{ vars.WORLDCONS_OPS_HEARTBEAT_READ_AUTHORITY || 'supabase' }}
# The Cloudflare masterdash Worker resolves its own
# WORLDCONS_OPS_HEARTBEAT_READ_AUTHORITY var independently.
WORLDCONS_OPS_HEARTBEAT_READ_AUTHORITY=supabase
# M11.4 admin_ops_events write authority. Default "supabase" preserves the
# existing direct Supabase insert/dedupe-read/prune in lib/ops/watchdog.ts
# (used by scripts/ops-watchdog.ts and app/api/ops/watchdog/route.ts) exactly.
# "d1-canary" routes only a deliberately marked canary window;
# "d1" routes every admin ops event to worldcons_ops. The boundary var
# WORLDCONS_ADMIN_OPS_EVENTS_WRITE_AUTHORITY is resolved independently by the
# worldcons-ops-write Worker. The Node-side d1 authority delivers through the
# same authenticated worldcons-ops-write boundary (base URL and OIDC audience
# above); a selected D1 authority FAILS CLOSED and never silently falls back.
WORLDCONS_ADMIN_OPS_EVENTS_WRITE_AUTHORITY=supabase
# M11.4 live D1 canary marker (optional, inert when unset). When set to
# true/1 the Node writer adds detail.m11AdminOpsEventsCanary=true for events
# written during the window, and the boundary's d1-canary selector accepts only
# that exact marker. Unset it in the resting state.
# WORLDCONS_ADMIN_OPS_EVENTS_CANARY_MARKER=
# M11.4R admin_ops_events read authority. Resolved independently from the write
# authority, exactly like the M11.3R heartbeat read authority. Default
# "supabase" preserves the existing listAdminOpsEvents read exactly; "d1"
# selects the migrated worldcons_ops list and FAILS CLOSED when unavailable.
# There is deliberately no d1-canary read mode.
WORLDCONS_ADMIN_OPS_EVENTS_READ_AUTHORITY=supabase
# M13 permanent D1 authority profile. This is the single bounded switch for the
# whole M13 retirement. Default "supabase" (or unset) leaves every per-domain
# selector exactly as configured below. "d1" expands to exactly the authored
# per-domain selectors, each set to "d1" (never "d1-canary"), so the Cloudflare
# runtime, the worldcons-ops-write boundary and the GitHub repository vars move
# together. Rollback is the same operation with the value set back to "supabase".
# Any other value fails closed: the Worker/boundary refuses to serve rather than
# silently running under the resting default. The profile is applied in
# worker/index.ts and workers/ops-write/src/index.ts; it must NOT be applied to
# only one side, or the boundary and the runtime can disagree. Use
# `pnpm m13:readiness --emit-authority-env` to print the exact forward/rollback
# values, and `pnpm m13:readiness` to verify the assignment before/after a switch.
WORLDCONS_M13_AUTHORITY_PROFILE=supabase
