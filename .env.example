# Vercel Private Blob artifact externalization (M1-M3). Write requires read to be
# enabled. When read is enabled the service dual-reads inline and Blob-backed
# fetch/normalization artifacts with size and SHA-256 checks. Keep both false by default.
CASE_BACKFILL_ARTIFACT_BLOB_WRITE_ENABLED=false
CASE_BACKFILL_ARTIFACT_BLOB_READ_ENABLED=false
# M4A backfills existing inline fetch/normalization artifacts onto private Blob.
# Run it as a dry run first (default), then add --execute to attach refs. It needs
# the Blob credentials above, uploads and verifies size + SHA-256 before mutating,
# preserves inline content, and is idempotent on rerun:
#   pnpm externalize:artifacts --kind=fetch --source=<source-key> --batch-size=25
#   pnpm externalize:artifacts --kind=fetch --source=<source-key> --execute
# M4B clears the now-redundant inline fetch/normalization payload only after M4A has
# externalized it. It defaults to a dry run, requires an explicit
# --acknowledge-irreversible together with --execute, requires
# CASE_BACKFILL_ARTIFACT_BLOB_READ_ENABLED=true, and verifies each Blob object's
# exact size and SHA-256 plus valid JSON before the DB row is cleared. It never
# deletes Blob objects and is idempotent on rerun:
#   pnpm clear:inline-artifacts --kind=fetch --source=<source-key> --batch-size=25
#   pnpm clear:inline-artifacts --kind=fetch --source=<source-key> --execute --acknowledge-irreversible
# M5 read-only artifact Blob readiness/observability. Reports aggregate-only
# fetch/normalization presence, externalization, metadata, and ledger coverage
# with derived NEW_WRITE_READY / INLINE_CLEAR_READY gates. It is read-only, takes
# no write flags, and performs zero Blob reads by default. Optional bounded Blob
# verification (--verify-sample=N, off by default) also requires the Blob read
# flag, and reports aggregate counts only:
#   pnpm readiness:artifact-blob
#   pnpm readiness:artifact-blob --source=<source-key> --kind=fetch
#   pnpm readiness:artifact-blob --source=<source-key> --verify-sample=10 --require-inline-clear-ready
# Both flags below stay false; after a real inline clear, restoring inline storage
# requires a separately designed restore path (not implemented).
# Vercel Blob private store credentials. The SDK reads these from the environment;
# never store their values, signed URLs, or object tokens in the database.
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=   # injected and rotated by Vercel; never commit a value
# BLOB_READ_WRITE_TOKEN=   # only needed when running outside Vercel
# M6A article raw_text private Blob externalization. READ enables dual-read
# hydration of externalized raw_text on article detail reads; WRITE enables the
# flag-on capture that uploads raw_text to private Blob before the publication RPC.
# WRITE requires READ, and both stay false by default.
ARTICLE_RAW_BLOB_READ_ENABLED=false
ARTICLE_RAW_BLOB_WRITE_ENABLED=false
# M6B backfills existing inline article raw_text onto private Blob by attaching a
# verified content-addressed ref while preserving inline raw_text, for both the
# articles table and article_content_versions_p3. It needs the Blob credentials
# above, uploads and verifies size + SHA-256 before the permit-guarded attach, is
# idempotent on rerun, and never clears inline raw_text. Executing also requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true and an explicit --acknowledge-externalization;
# a dry run requires neither and WRITE is never required. On the articles table the
# attach advances the row's existing updated_at, so use bounded batches away from
# concurrent publication edits:
#   pnpm externalize:article-raw --table=articles --source=<source-key> --batch-size=25
#   pnpm externalize:article-raw --table=articles --source=<source-key> --execute --acknowledge-externalization
ADMIN_P5_COMPATIBILITY_OBSERVATION_ENABLED=false
ADMIN_P5_COMPATIBILITY_OBSERVATION_SAMPLE_RATE=0.1
ADMIN_P5_GOVERNANCE_UI_ENABLED=false
ADMIN_P5_HEALTH_VERIFICATION_ENABLED=false
