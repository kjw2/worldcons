CASE_CATALOG_US_CONAN_ENABLED=false
# Cloudflare R2 private artifact externalization. Write requires read to be
# enabled. Blob-backed fetch/normalization artifacts retain size and SHA-256 checks.
CASE_BACKFILL_ARTIFACT_BLOB_WRITE_ENABLED=false
CASE_BACKFILL_ARTIFACT_BLOB_READ_ENABLED=false
# M4A backfills existing inline fetch/normalization artifacts onto private Blob.
# Run it as a dry run first (default), then add --execute to attach refs. It needs
# the Blob credentials above, uploads and verifies size + SHA-256 before mutating,
# preserves inline content, and is idempotent on rerun:
#   pnpm externalize:artifacts --kind=fetch --source=<source-key> --batch-size=25
#   pnpm externalize:artifacts --kind=fetch --source=<source-key> --execute
# M4B clears the now-redundant inline fetch/normalization payload only after M4A has
# externalized it. It defaults to a dry run, requires an explicit
# --acknowledge-irreversible together with --execute, requires
# CASE_BACKFILL_ARTIFACT_BLOB_READ_ENABLED=true, and verifies each Blob object's
# exact size and SHA-256 plus valid JSON before the DB row is cleared. It never
# deletes Blob objects and is idempotent on rerun:
#   pnpm clear:inline-artifacts --kind=fetch --source=<source-key> --batch-size=25
#   pnpm clear:inline-artifacts --kind=fetch --source=<source-key> --execute --acknowledge-irreversible
# M5 read-only artifact Blob readiness/observability. Reports aggregate-only
# fetch/normalization presence, externalization, metadata, and ledger coverage
# with derived NEW_WRITE_READY / INLINE_CLEAR_READY gates. It is read-only, takes
# no write flags, and performs zero Blob reads by default. Optional bounded Blob
# verification (--verify-sample=N, off by default) also requires the Blob read
# flag, and reports aggregate counts only:
#   pnpm readiness:artifact-blob
#   pnpm readiness:artifact-blob --source=<source-key> --kind=fetch
#   pnpm readiness:artifact-blob --source=<source-key> --verify-sample=10 --require-inline-clear-ready
# Cloudflare R2 is the sole artifact Blob provider.
ARTIFACT_BLOB_PROVIDER=r2
ARTIFACT_BLOB_BUCKET=worldcons-artifacts
# Node/CLI R2 access. Keep all values server-side. R2_ENDPOINT may be supplied
# explicitly; otherwise R2_ACCOUNT_ID derives
# https://<account-id>.r2.cloudflarestorage.com. Region defaults to auto.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# Operator-only migration bridge. When ARTIFACT_BLOB_PROVIDER=r2, setting this to
# "wrangler" makes Node maintenance CLIs use the locally authenticated Wrangler
# OAuth session instead of S3 credentials. This is for bounded migration/backfill
# operations only; application runtime code does not use this transport.
# ARTIFACT_BLOB_R2_OPERATOR_TRANSPORT=wrangler
# Optional absolute Wrangler executable/shim path for operator migration CLIs.
# On Windows the default is %APPDATA%\npm\wrangler.cmd so pnpm/tsx cannot
# accidentally resolve a stale local node_modules shim.
# WORLDCONS_WRANGLER_BIN=
# M6A article raw_text private Blob externalization. READ enables dual-read
# hydration of externalized raw_text on article detail reads; WRITE enables the
# flag-on capture that uploads raw_text to private Blob before the publication RPC.
# WRITE requires READ, and both stay false by default.
ARTICLE_RAW_BLOB_READ_ENABLED=false
ARTICLE_RAW_BLOB_WRITE_ENABLED=false
# M6B backfills existing inline article raw_text onto private Blob by attaching a
# verified content-addressed ref while preserving inline raw_text, for both the
# articles table and article_content_versions_p3. It needs the Blob credentials
# above, uploads and verifies size + SHA-256 before the permit-guarded attach, is
# idempotent on rerun, and never clears inline raw_text. Executing also requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true and an explicit --acknowledge-externalization;
# a dry run requires neither and WRITE is never required. On the articles table the
# attach advances the row's existing updated_at, so use bounded batches away from
# concurrent publication edits:
#   pnpm externalize:article-raw --table=articles --source=<source-key> --batch-size=25
#   pnpm externalize:article-raw --table=articles --source=<source-key> --execute --acknowledge-externalization
# M6C clears the now-redundant inline article raw_text only after M6A/M6B have
# attached and ledgered the verified content-addressed Blob metadata. It defaults to
# a dry run that performs zero Blob reads and zero DB mutation, requires an explicit
# --acknowledge-inline-clear together with --execute, requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true, and nowhere requires WRITE. Execute verifies
# each Blob object's exact size and SHA-256, decodes the stored JSON string, and
# requires the decoded text to exactly equal the row's current inline raw_text before
# the clear RPC runs. It never writes or deletes a Blob object and is idempotent on
# rerun. WARNING: clearing an `articles` row advances its existing updated_at, so run
# bounded batches away from concurrent publication edits:
#   pnpm clear:article-raw-inline --table=articles --source=<source-key> --batch-size=25
#   pnpm clear:article-raw-inline --table=articles --source=<source-key> --execute --acknowledge-inline-clear
# M6E article raw_text inline restore, the only supported way to put a cleared inline
# raw_text back from its verified private Blob copy, for both the articles table and
# article_content_versions_p3. It defaults to a dry run that performs zero Blob reads
# and zero DB mutation and classifies candidates as planned/conflict/not-ready,
# requires an explicit --acknowledge-inline-restore together with --execute, requires
# ARTICLE_RAW_BLOB_READ_ENABLED=true, and nowhere requires WRITE. Execute verifies each
# Blob object's exact size and SHA-256 and decodes the stored JSON string, then calls
# the restore RPC with the decoded text and the exact recorded metadata; the database
# recomputes the JSON-string document size and SHA-256 and requires them to equal the
# recorded size/hash. It never writes or deletes a Blob object and is idempotent on
# rerun. Run a tiny restore canary first, and only do a large-scale M6C inline clear
# after M6E has been deployed and tested. No VACUUM FULL and no pg_repack. Restoring an
# `articles` row advances its existing updated_at, so use bounded batches away from
# concurrent publication edits:
#   pnpm restore:article-raw-inline --table=articles --source=<source-key> --batch-size=25
#   pnpm restore:article-raw-inline --table=articles --source=<source-key> --batch-size=1 --execute --acknowledge-inline-restore
ADMIN_P5_COMPATIBILITY_OBSERVATION_ENABLED=false
ADMIN_P5_COMPATIBILITY_OBSERVATION_SAMPLE_RATE=0.1
ADMIN_P5_GOVERNANCE_UI_ENABLED=false
ADMIN_P5_HEALTH_VERIFICATION_ENABLED=false
# Ops heartbeat authority is permanently D1. Manual/local callers that cross the
# public /v1/ops/* compatibility boundary authenticate with WORLDCONS_OPS_WRITE_TOKEN.
# Cloudflare-internal execution uses D1/service bindings directly and does not
# depend on external deployment/database providers.
WORLDCONS_OPS_HEARTBEAT_WRITE_AUTHORITY=d1
# WORLDCONS_OPS_WRITE_BASE_URL=
#
# M11.3 live D1 canary selector (optional, inert when unset). A real
# The legacy canary marker remains available only for explicit local diagnostics.
# WORLDCONS_OPS_HEARTBEAT_CANARY_MARKER=
# Optional operator bearer (must equal the Worker's OPS_WRITE_TOKEN):
# WORLDCONS_OPS_WRITE_TOKEN=
# Reads and admin ops events are permanently D1 and fail closed.
WORLDCONS_OPS_HEARTBEAT_READ_AUTHORITY=d1
WORLDCONS_ADMIN_OPS_EVENTS_WRITE_AUTHORITY=d1
# M11.4 live D1 canary marker (optional, inert when unset). When set to
# true/1 the Node writer adds detail.m11AdminOpsEventsCanary=true for events
# written during the window, and the boundary's d1-canary selector accepts only
# that exact marker. Unset it in the resting state.
# WORLDCONS_ADMIN_OPS_EVENTS_CANARY_MARKER=
WORLDCONS_ADMIN_OPS_EVENTS_READ_AUTHORITY=d1
# M13 authority profile and rate limiter are permanently Cloudflare-native.
WORLDCONS_M13_AUTHORITY_PROFILE=d1
WORLDCONS_RATE_LIMIT_AUTHORITY=d1
WORLDCONS_PORTAL_TOKEN=
